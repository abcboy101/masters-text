{
    "episode_event_8080_anniversary/4001_1001_100_10": "놀랐어, 세레나...!",
    "episode_event_8080_anniversary/4001_1001_200_10": "설마 개굴닌자의 메가진화를\n보게 될 줄이야!",
    "episode_event_8080_anniversary/4001_1001_300_10": "분명 파시오에서\n길러 왔던 유대가",
    "episode_event_8080_anniversary/4001_1001_400_10": "저희에게 새로운 힘을 준 걸 거예요!",
    "episode_event_8080_anniversary/4001_1001_500_10": "개굴닌자에게는 지금까지도\n많은 도움을 받아 왔지만...",
    "episode_event_8080_anniversary/4001_1001_600_10": "메가진화를 할 수 있게 되었으니\n이제 더 의지할 일이 많아질 것 같네요!",
    "episode_event_8080_anniversary/4001_1001_700_10": "그거참 든든하겠는걸~!\n지금까지 봐 온 것보다 더욱 반짝이는구나!",
    "episode_event_8080_anniversary/4001_1001_800_10": "그래서 그런 너희들이 활약하기에\n적합한 자리를 마련하려는 중인데 말이야",
    "episode_event_8080_anniversary/4001_1001_900_10": "너희들에게 아주 잘 어울리는 역할일 거란다\n해 보겠니?",
    "episode_event_8080_anniversary/4001_1001_1000_10": "물론이죠! 맡겨만 주세요!",
    "episode_event_8080_anniversary/4001_1001_1100_10": "좋은 대답이야!",
    "episode_event_8080_anniversary/4001_1001_1200_10": "사실은 같은 제안을\n다른 트레이너 한 명에게도 했는데...",
    "episode_event_8080_anniversary/4002_1101_100_20": "다음 날...",
    "episode_event_8080_anniversary/4002_1001_100_10": "이번 축제는\n플라타느박사의 제안을 받아\n개최하게 되었다!",
    "episode_event_8080_anniversary/4002_1001_200_10": "테마는 \"메가진화\"",
    "episode_event_8080_anniversary/4002_1001_300_10": "이 버디즈들이 분위기를 띄워 줄 거다!",
    "episode_event_8080_anniversary/4002_1001_400_10": "이번에는 메가진화로 회장을\n가득 채워 주겠어!",
    "episode_event_8080_anniversary/4002_1001_500_10": "일단 우리들이 앞장서서\n메가진화의 매력을 알릴 거야!",
    "episode_event_8080_anniversary/4002_1001_600_10": "다들 잘 따라와야 해!",
    "episode_event_8080_anniversary/4002_1001_700_10": "그러면 바로 파티를 시작해 볼까!",
    "episode_event_8080_anniversary/6801_1031_100_10": "파티 준비는 다 했어?",
    "episode_event_8080_anniversary/6801_1001_100_10": "성공적인 파티의 열쇠는\n우리한테 달려 있다고 해도\n과언이 아니라고",
    "episode_event_8080_anniversary/6801_1001_200_10": "기대에 보답할 수 있도록\n힘내 봐요!",
    "episode_event_8080_anniversary/6801_1001_300_10": "저희들의 메가진화로\n빛나는 추억을 만들자구요!",
    "episode_event_8080_anniversary/4003_1001_100_10": "오오! 이거 대단한데?",
    "episode_event_8080_anniversary/4003_1001_200_10": "감개무량하구려...",
    "episode_event_8080_anniversary/4003_1001_300_10": "이 포켓몬에 대해 알아?",
    "episode_event_8080_anniversary/4003_1001_400_10": "당연히 알고 있소이다!",
    "episode_event_8080_anniversary/4003_1001_500_10": "숨겨서 무엇 하리!\n개굴닌자의 정체는 \"시노비포켓몬\"!",
    "episode_event_8080_anniversary/4003_1001_600_10": "하나! 메가진화라는 파워 업이\n더 있는 줄은 몰랐소이다!",
    "episode_event_8080_anniversary/4003_1001_700_10": "이 모습은 처음 본다는 말이군",
    "episode_event_8080_anniversary/4003_1001_800_10": "메가진화하면 숨는 스타일에서\n일부러 상대에게 모습을 드러내는 스타일로\n전법도 바뀌게 돼요",
    "episode_event_8080_anniversary/4003_1001_900_10": "반응 속도가 엄청 빨라져서\n트레이너인 저도\n상황을 따라가는 게 힘들 정도예요!",
    "episode_event_8080_anniversary/4003_1001_1000_10": "이 당당한 태도로부터\n승리를 확신하는 듯한\n자신감이 느껴지는걸?",
    "episode_event_8080_anniversary/4003_1001_1100_10": "저도 모습을 바꾼\n개굴닌자에게 맞춰서...",
    "episode_event_8080_anniversary/4003_1001_1200_10": "파티를 위한 코디를 해 봤어요!",
    "episode_event_8080_anniversary/4003_1001_1300_10": "아하! 버디에게 맞춰서\n수준 높은 코디를 소화한 거였군!\n제법인데?",
    "episode_event_8080_anniversary/4003_1001_1400_10": "자신에게 어떤 것이 어울리는지\n잘 알고 있나 보네",
    "episode_event_8080_anniversary/4003_1001_1500_10": "많은 참고가 되었소이다",
    "episode_event_8080_anniversary/4003_1001_1600_10": "감사합니다!\n칭찬해 주시니 기쁘네요!",
    "episode_event_8080_anniversary/4003_1001_1700_10": "그런데...",
    "episode_event_8080_anniversary/4003_1001_1800_10": "이렇게 강한 포켓몬을 상대하려면\n대체 어떻게 싸워야 할까?",
    "episode_event_8080_anniversary/4003_1001_1900_10": "어떤 포켓몬이라 해도 만능은 아니야",
    "episode_event_8080_anniversary/4003_1001_2000_10": "내가 유리하게 싸울 수 있는\n필드로 끌어들이면 돼!",
    "episode_event_8080_anniversary/4003_1001_2100_10": "날씨 변화의 전법으로 대항해 주겠어!",
    "episode_event_8080_anniversary/4003_1001_2200_10": "그건 아주 까다로울 것 같네요...!",
    "episode_event_8080_anniversary/4003_1001_2300_10": "그 외에도 개굴닌자에게 대항할 수 있는\n시노비 기술을 지닌 포켓몬이\n있을지도 모르는 일이오!",
    "episode_event_8080_anniversary/4003_1001_2400_10": "맞아! 우리가 알지 못할 뿐이고\n파시오에 찾아올 가능성도 있지!",
    "episode_event_8080_anniversary/4003_1001_2500_10": "닌자 같은 포켓몬을\n더 만날 수 있었으면 좋겠네!",
    "episode_event_8080_anniversary/4003_1001_2600_10": "다들 닌자를 좋아하시는군요...!",
    "episode_event_8080_anniversary/4004_1001_100_10": "레드!\n네가 사용할 수 있게 된\n테라스탈에 대항하기 위해...",
    "episode_event_8080_anniversary/4004_1001_200_10": "나도 망나뇽과 맹훈련을 해서\n메가진화의 힘을 얻었다고!",
    "episode_event_8080_anniversary/4004_1001_300_10": "잘 듣고 기억해!",
    "episode_event_8080_anniversary/4004_1001_400_10": "네가 얼마를 앞질러 가든\n나도 반드시 그 뒤를 따라잡을 거다!",
    "episode_event_8080_anniversary/4004_1001_500_10": "... ... ...",
    "episode_event_8080_anniversary/4004_1001_600_10": "전력을 다해 부딪칠 수 있는\n라이벌이 있다는 건\n정말 행복한 일인 것 같아!",
    "episode_event_8080_anniversary/4004_1001_700_10": "네...!\n언제까지나 변하지 않는 관계로\n있을 수 있다는 건 정말 근사하네요!",
    "episode_event_8080_anniversary/4004_1001_800_10": "근데 그린, 왜 망나뇽이야?",
    "episode_event_8080_anniversary/4004_1001_900_10": "지금까지 함께 싸우는 모습을\n본 적이 없었는데...",
    "episode_event_8080_anniversary/4004_1001_1000_10": "다들 깜짝 놀라게 해 주고 싶었어서\n이 녀석에 대한 건 계속 숨겨 왔었어",
    "episode_event_8080_anniversary/4004_1001_1100_10": "이때다 싶은 타이밍에 선보이려고\n때를 기다리고 있었지!",
    "episode_event_8080_anniversary/4004_1001_1200_10": "기르는 방법이나 전술을 배우기 위해\n목호한테만큼은 먼저 말해 뒀었지만 말이야",
    "episode_event_8080_anniversary/4004_1001_1300_10": "하지만 넌 이미 눈치채고 있었지?",
    "episode_event_8080_anniversary/4004_1001_1400_10": "... ... ...",
    "episode_event_8080_anniversary/4004_1001_1500_10": "역시 포켓몬과 관련된 거면\n너한테는 숨길 수가 없다니까!",
    "episode_event_8080_anniversary/4004_1001_1600_10": "라이벌끼리\n서로 통하는 게 있으신 거군요!",
    "episode_event_8080_anniversary/4004_1001_1700_10": "...그러고 보니",
    "episode_event_8080_anniversary/4004_1001_1800_10": "기껏 파티를 열었는데\n왜 레드도 단델도 평소 옷차림 그대로인 거야!?",
    "episode_event_8080_anniversary/4004_1001_1900_10": "봄이는 알아서 잘 차려입고 왔잖아?",
    "episode_event_8080_anniversary/4004_1001_2000_10": "저는 아빠하고 같이\n포켓몬 연구자들의 모임에\n얼굴을 비출 때도 있었거든요...",
    "episode_event_8080_anniversary/4004_1001_2100_10": "나도 딱히 아무렇게나 입고 온 건 아냐!",
    "episode_event_8080_anniversary/4004_1001_2200_10": "이 유니폼이야말로\n진지한 시합에 나서는\n내 정장 같은 옷이라고!",
    "episode_event_8080_anniversary/4004_1001_2300_10": "레드도 나랑 같은 생각 아냐?",
    "episode_event_8080_anniversary/4004_1001_2400_10": "... ... ...",
    "episode_event_8080_anniversary/4004_1001_2500_10": "뭐? 맨날 입고 싸웠던\n평상복을 입고 있어야 마음이 놓인다고...?",
    "episode_event_8080_anniversary/4004_1001_2600_10": "하여간...\n못 말릴 녀석들이라니까",
    "episode_event_8080_anniversary/4004_1001_2700_10": "봄이, 아무래도\n드레스 코드만큼은...",
    "episode_event_8080_anniversary/4004_1001_2800_10": "우리의 압승인 것 같은데!",
    "episode_event_8080_anniversary/4005_1001_100_10": "메가진화한\n독침붕과 함께...",
    "episode_event_8080_anniversary/4005_1001_200_10": "정말 멋져 멋져!",
    "episode_event_8080_anniversary/4005_1001_300_10": "좋아~!\n좀 더 다양한 표정을 부탁할게!",
    "episode_event_8080_anniversary/4005_1001_400_10": "이, 이러면 되나요...?",
    "episode_event_8080_anniversary/4005_1001_500_10": "북신의 고장에서는 본 적이 없는\n멋진 벌레포켓몬이에요...!",
    "episode_event_8080_anniversary/4005_1001_600_10": "그러게, 나도 처음 봤어",
    "episode_event_8080_anniversary/4005_1001_700_10": "고향인 신오지방에서도\n본 적 없었던 것 같아",
    "episode_event_8080_anniversary/4005_1001_800_10": "오~! 그렇구나!",
    "episode_event_8080_anniversary/4005_1001_900_10": "관동지방에서는\n흔히 볼 수 있는 포켓몬이에요!",
    "episode_event_8080_anniversary/4005_1001_1000_10": "이 아이는 상록숲에서 만났던\n뿔충이를 길러서 진화시킨 포켓몬이죠!",
    "episode_event_8080_anniversary/4005_1001_1100_10": "금방 쑥쑥 자라서\n엄청 든든하다구요!",
    "episode_event_8080_anniversary/4005_1001_1200_10": "벌레포켓몬은 성장 속도가\n빠른 게 특징이니까 말이지!",
    "episode_event_8080_anniversary/4005_1001_1300_10": "새내기 트레이너들에게는\n특히 듬직하게 느껴질지도 모르겠네!",
    "episode_event_8080_anniversary/4005_1001_1400_10": "성장이 빠르다...",
    "episode_event_8080_anniversary/4005_1001_1500_10": "리프나 카지 같은 연령대의\n친구들하고 많이 닮았네",
    "episode_event_8080_anniversary/4005_1001_1600_10": "눈부신 속도로 성장해서\n놀랄 만큼 든든해지는 모습이 말이야!",
    "episode_event_8080_anniversary/4005_1001_1700_10": "동감이야!",
    "episode_event_8080_anniversary/4005_1001_1800_10": "만날 때마다 한층 더\n반짝이게 됐다는 게 느껴지더라고!",
    "episode_event_8080_anniversary/4005_1001_1900_10": "경험을 쌓고 성장할 때마다\n빛과도 같은 속도로\n끊임없이 세계를 넓혀 가는 모습...",
    "episode_event_8080_anniversary/4005_1001_2000_10": "그 순간이 정말 아름다운 거지!",
    "episode_event_8080_anniversary/4005_1001_2100_10": "그런 무한한 가능성을 품고 있는\n벌레포켓몬과 트레이너...",
    "episode_event_8080_anniversary/4005_1001_2200_10": "너희 버디즈의\n지금밖에 없는 아름다운 순간을\n내가 잘 담아내 줄게!",
    "episode_event_8080_anniversary/4005_1001_2300_10": "그러면... 저희는 저희끼리\n지금밖에 할 수 없을 승부를 하죠!",
    "episode_event_8080_anniversary/4005_1001_2400_10": "제 메가자리랑 대결해 주실래요?",
    "episode_event_8080_anniversary/4005_1001_2500_10": "물론이지!",
    "episode_event_8080_anniversary/4005_1001_2600_10": "벌레포켓몬끼리의 대결이라...!",
    "episode_event_8080_anniversary/4005_1001_2700_10": "어떤 승부가 펼쳐질지\n두근거려!",
    "episode_event_8080_anniversary/4006_1001_100_10": "심향과 갸라도스...",
    "episode_event_8080_anniversary/4006_1001_200_10": "둘을 보고 있으면\n\"그때\"가 생각나",
    "episode_event_8080_anniversary/4006_1001_300_10": "분노의 호수에서 일어났던 사건을\n말씀하시는 거죠?",
    "episode_event_8080_anniversary/4006_1001_400_10": "그 이야기는\n나도 들은 적이 있어...!",
    "episode_event_8080_anniversary/4006_1001_500_10": "로켓단은 정말\n어떻게 그런 짓을 하나 몰라!",
    "episode_event_8080_anniversary/4006_1001_600_10": "대체 무슨 일이 있었길래요?",
    "episode_event_8080_anniversary/4006_1001_700_10": "전에 성도지방에서 로켓단이\n이상한 전파를 퍼뜨려서...",
    "episode_event_8080_anniversary/4006_1001_800_10": "호수의 잉어킹을\n억지로 갸라도스로 진화시키는\n일이 있었거든",
    "episode_event_8080_anniversary/4006_1001_900_10": "그럴 수가... 너무해요...",
    "episode_event_8080_anniversary/4006_1001_1000_10": "그래... 그런 일은\n두 번 다시는 일어나선 안 돼",
    "episode_event_8080_anniversary/4006_1001_1100_10": "포켓몬의 진화는 애초에\n심향이나 다른 버디즈들처럼 되어야 하는 거지",
    "episode_event_8080_anniversary/4006_1001_1200_10": "포켓몬과 착실히 유대를 쌓고\n메가진화시킨 심향은\n아주 멋진 트레이너라고 할 수 있으니 말이야",
    "episode_event_8080_anniversary/4006_1001_1300_10": "그야말로 교과서로 삼을 만한\n버디즈라니까!",
    "episode_event_8080_anniversary/4006_1001_1400_10": "뭔가 쑥스럽네요...!",
    "episode_event_8080_anniversary/4006_1001_1500_10": "나는 전에 메가진화한\n갸라도스와 싸워 봐서 알 수 있어",
    "episode_event_8080_anniversary/4006_1001_1600_10": "그 갸라도스가\n정말 강하다는 걸 말이야!",
    "episode_event_8080_anniversary/4006_1001_1700_10": "고마워! 하지만...",
    "episode_event_8080_anniversary/4006_1001_1800_10": "강력하니까\n더더욱 폭주하는 일이 없도록\n조심스럽게 나아갈 거야!",
    "episode_event_8080_anniversary/4007_1001_100_10": "후, 훌륭합니다...!",
    "episode_event_8080_anniversary/4007_1001_200_10": "굉장히 멋지게 길러 냈구나\n정말 대단하다...!",
    "episode_event_8080_anniversary/4007_1001_300_10": "헤헤! 역시 그렇지?",
    "episode_event_8080_anniversary/4007_1001_400_10": "흐음~ 메가진화라...",
    "episode_event_8080_anniversary/4007_1001_500_10": "음? 뭔가 맥 빠지는 반응이군요",
    "episode_event_8080_anniversary/4007_1001_600_10": "제빈은 메가진화를\n습득해 보고 싶은 생각이 없어?",
    "episode_event_8080_anniversary/4007_1001_700_10": "글쎄~ 뭐, 애써 본다고\n다 된다는 보장은 없는 법이잖아",
    "episode_event_8080_anniversary/4007_1001_800_10": "나도 과하게 의식하지 않는 게\n더 좋은 결과로 이어지는 경우도 있다고 생각해!",
    "episode_event_8080_anniversary/4007_1001_900_10": "메가진화는 트레이너 혼자서\n강하게 바란다고 얻을 수 있는 게 아니니까...",
    "episode_event_8080_anniversary/4007_1001_1000_10": "마음만 앞서서 서둘러 본들\n엇나가기만 할 거야",
    "episode_event_8080_anniversary/4007_1001_1100_10": "때로는 멀리 돌아서\n천천히 걸어가는 것도 인생이란 거지?",
    "episode_event_8080_anniversary/4007_1001_1200_10": "헤헤헷, 뭘 좀 아는구나?\n브라더!",
    "episode_event_8080_anniversary/4007_1001_1300_10": "그렇네요\n저도 억지로 권할 마음은 없습니다",
    "episode_event_8080_anniversary/4007_1001_1400_10": "자기 나름대로의 속도로 걷는 것도\n물론 중요한 일이니까요",
    "episode_event_8080_anniversary/4007_1001_1500_10": "하지만...",
    "episode_event_8080_anniversary/4007_1001_1600_10": "그것 못지않게\n정열을 품고 쭉 달려나가는 것도\n때로는 중요합니다!",
    "episode_event_8080_anniversary/4007_1001_1700_10": "아저씨는 저한테 뭘 바라시는 거예요?",
    "episode_event_8080_anniversary/4007_1001_1800_10": "때로는 자신의 마음을\n마주하는 것도 중요하다는 이야기입니다",
    "episode_event_8080_anniversary/4007_1001_1900_10": "이처럼 맹렬한 드래곤의 모습을 봤으니...",
    "episode_event_8080_anniversary/4007_1001_2000_10": "제빈군도 저와 마찬가지로\n뭔가 느끼는 바가 있지 않았나요?",
    "episode_event_8080_anniversary/4007_1001_2100_10": "확실히 피가 끓어오르는 느낌은 드네요",
    "episode_event_8080_anniversary/4007_1001_2200_10": "메가진화한 드래곤포켓몬 같은 건\n블루베리 아카데미에선 못 봤으니까 말이죠",
    "episode_event_8080_anniversary/4007_1001_2300_10": "관심이 있긴 한 거구나?",
    "episode_event_8080_anniversary/4007_1001_2400_10": "그럼! 쓸 수 있는 전법이 늘면\n승부를 더 잘 즐길 수 있게 되니까 말이야!",
    "episode_event_8080_anniversary/4008_1001_100_10": "메가진화의 매력을\n더 널리 알릴 기회가\n많아졌으면 좋겠어요!",
    "episode_event_8080_anniversary/4008_1001_200_10": "앞으로도 메가진화를 계속 갈고닦아서\n모두에게 전해 나가는 것...\n그게 계승자의 역할일 테니까요!",
    "episode_event_8080_anniversary/4008_1001_300_10": "저도 배우 일을 통해\n전 세계 사람들에게 메가진화의 멋짐을\n전달하고 싶어요",
    "episode_event_8080_anniversary/4008_1001_400_10": "그게 무대 앞에서 주목을 받는\n챔피언인 저의 역할일 테니까요",
    "episode_event_8080_anniversary/4008_1001_500_10": "책임이 막중한 일이지만...\n그 일을 즐기고 계신 듯하니 다행이네요!",
    "episode_event_8080_anniversary/4008_1001_600_10": "맞아, 하고 싶은 일과 할 수 있는 일이\n같다는 건 정말 행복한 일이라고 생각해",
    "episode_event_8080_anniversary/4008_1001_700_10": "나는 언젠가\n모든 메가진화를 다뤄 보고 싶어!",
    "episode_event_8080_anniversary/4008_1001_800_10": "그렇다면 여행을 떠나 보는 것도\n재미있을 거야",
    "episode_event_8080_anniversary/4008_1001_900_10": "여행은 내가 모르는 세계를\n발견하는 일의 연속이거든",
    "episode_event_8080_anniversary/4008_1001_1000_10": "여행이라... 좋네요",
    "episode_event_8080_anniversary/4008_1001_1100_10": "저도 영화를 촬영하러\n모르는 곳에 갈 때가 있는데...\n새로운 만남이 항상 뒤따르곤 했어요",
    "episode_event_8080_anniversary/4008_1001_1200_10": "와아...! 재미있을 거 같아요!",
    "episode_event_8080_anniversary/4008_1001_1300_10": "발길 닿는 대로 다니는\n여행도 재밌을 것 같지 않아?",
    "episode_event_8080_anniversary/4008_1001_1400_10": "아무것도 정해 두지 않고서\n여행을 다니는 거야?",
    "episode_event_8080_anniversary/4008_1001_1500_10": "응, 내가 N을 찾아 여행을 떠났을 당시에는\nN에 대한 생각밖에 없었지만",
    "episode_event_8080_anniversary/4008_1001_1600_10": "요즘은 도착한 곳에서\n즐거운 일을 찾아보는 그런 여행도\n해 보고 싶다는 생각이 들더라고",
    "episode_event_8080_anniversary/4008_1001_1700_10": "그러다가 두 사람은 마침내\n파시오에서 만나게 된 거였구나...!",
    "episode_event_8080_anniversary/4008_1001_1800_10": "나도 여행을 즐기면서\n새로운 메가진화도\n찾아내고 말 거야!",
    "episode_event_8080_anniversary/4008_1001_1900_10": "분명 해낼 수 있을 거야!\n만약 코르니가 여행을 떠나게 되면\n최대한 응원해 줄게!",
    "episode_event_8080_anniversary/4009_1001_100_10": "모두의 메가진화는\n특별한 빛으로서\n많은 사람들의 마음에 남게 되었구나...",
    "episode_event_8080_anniversary/4009_1001_200_10": "덕분에 잊지 못할 하루가 됐어!",
    "episode_event_8080_anniversary/4009_1001_300_10": "별말씀을요!\n저희한테도 좋은 하루였어요!",
    "episode_event_8080_anniversary/4009_1001_400_10": "사실은...\n나도 최근 들어서 알게 된\n메가진화가 있단다",
    "episode_event_8080_anniversary/4009_1001_500_10": "그 놀라움과 감동을 맛볼 수 있는 것도\n포켓몬 연구의 재미지...",
    "episode_event_8080_anniversary/4009_1001_600_10": "메가진화의 가능성은\n포켓몬과 트레이너의\n유대의 수만큼 있는 걸지도 모르겠구나",
    "episode_event_8080_anniversary/4009_1001_700_10": "정말 그 말대로야...!",
    "episode_event_8080_anniversary/4009_1001_800_10": "그러니 그런 메가진화의 가능성을\n더 탐구하기 위해...",
    "episode_event_8080_anniversary/4009_1001_900_10": "마지막으로 하나 하고 싶은 게 있는데\n다들 해 볼래?",
    "episode_event_8080_anniversary/4009_1001_1000_10": "응, 나도 같은 생각 중이었어!",
    "episode_event_8080_anniversary/4009_1001_1100_10": "이 대결을 통해 축제의 막을\n닫는 거로 하자!",
    "episode_event_8080_anniversary/4009_1001_1200_10": "망나뇽! 메가진화다!",
    "episode_event_8080_anniversary/4009_1001_1300_10": "개굴닌자! 메가진화!",
    "episode_event_8080_anniversary/4009_1001_1400_10": "우리들만의 메가진화의 빛...!",
    "episode_event_8080_anniversary/4009_1001_1500_10": "유대의 힘을 똑똑히 보여 주자!"
}
