{
    "episode_event_8070_zagirl_and_gai/4001_1001_100_10": "파시오는 인공섬이라고 들었는데\n의외로 자연이 풍요로운 곳이네!",
    "episode_event_8070_zagirl_and_gai/4001_1001_200_10": "포켓몬이 스트레스 없이\n살 수 있도록 고민한 결과일까?",
    "episode_event_8070_zagirl_and_gai/4001_1001_300_10": "그 덕분인지 어느 포켓몬을 봐도\n편안하고 여유로워 보여",
    "episode_event_8070_zagirl_and_gai/4001_1001_400_10": "장크로다일과 메가니움도\n좋아해 줬으면 좋겠다",
    "episode_event_8070_zagirl_and_gai/4001_1001_500_10": "그건 그렇고...\n모처럼 새로운 마을에 왔으니\n여기저기 돌아다녀 보자",
    "episode_event_8070_zagirl_and_gai/4001_1001_600_10": "좋아, 어느 카페에\n어떤 메뉴가 있는지 같은 것들도\n체크해 두고 싶어",
    "episode_event_8070_zagirl_and_gai/4001_1001_700_10": "마음에 드는 휴식 공간을\n찾아 두는 건 중요하지!",
    "episode_event_8070_zagirl_and_gai/4001_1001_800_10": "미안!\n길을 좀 물어보고 싶은데...",
    "episode_event_8070_zagirl_and_gai/4001_1001_900_10": "네?",
    "episode_event_8070_zagirl_and_gai/4001_1001_1000_10": "아레나가 어디 있는지 알아?",
    "episode_event_8070_zagirl_and_gai/4001_1001_1100_10": "포켓몬 승부 대회에 나갈 예정인데\n길을 잃어버렸거든",
    "episode_event_8070_zagirl_and_gai/4001_1001_1200_10": "이대로 있다간 시작 시간에\n도착하지 못할 것 같아",
    "episode_event_8070_zagirl_and_gai/4001_1001_1300_10": "그거 큰일이네요...!",
    "episode_event_8070_zagirl_and_gai/4001_1001_1400_10": "하지만 저희도 파시오에 막 온 처지라\n아직 뭐가 어디 있는지 잘...",
    "episode_event_8070_zagirl_and_gai/4001_1001_1500_10": "좋아요, 안내해 드릴게요",
    "episode_event_8070_zagirl_and_gai/4001_1001_1600_10": "정말이야? 고마워!",
    "episode_event_8070_zagirl_and_gai/4001_1001_1700_10": "가이...!\n그렇게 쉽게 맡아도 괜찮겠어?",
    "episode_event_8070_zagirl_and_gai/4001_1001_1800_10": "이 폴리곤폰만 있으면\n어떻게든 될 거야!",
    "episode_event_8070_zagirl_and_gai/4001_1001_1900_10": "뭐... 지도를 보고 알 수 있으면\n괜찮...은가?",
    "episode_event_8070_zagirl_and_gai/4001_1001_2000_10": "게다가 곤란해하는 사람을\n내버려두기도 좀 그렇긴 하니까...",
    "episode_event_8070_zagirl_and_gai/4001_1001_2100_10": "역시 그렇지?",
    "episode_event_8070_zagirl_and_gai/4001_1001_2200_10": "우리한테는 MZ단으로서\n미르시티를 지켜 온 경험이 있잖아",
    "episode_event_8070_zagirl_and_gai/4001_1001_2300_10": "파시오에서도 열심히\n\"사람을 돕고\" 다니자고!",
    "episode_event_8070_zagirl_and_gai/6801_1031_100_10": "MZ단 등장!",
    "episode_event_8070_zagirl_and_gai/6801_1001_100_10": "이 섬에도 우리의 힘이\n필요한 상황이 많을 것 같아",
    "episode_event_8070_zagirl_and_gai/6801_1001_200_10": "그럼 파시오에서도 힘내서\n사람과 포켓몬을 도와야겠네!",
    "episode_event_8070_zagirl_and_gai/6801_1001_300_10": "그래, MZ단의 리더와\n비밀 병기의 활약을 보여 주자고",
    "episode_event_8070_zagirl_and_gai/4002_1001_100_10": "폴리곤폰에 나오는 내용대로라면\n이 길로 가면 될 거예요",
    "episode_event_8070_zagirl_and_gai/4002_1001_200_10": "두 사람 모두 고마워!",
    "episode_event_8070_zagirl_and_gai/4002_1001_300_10": "덕분에 다행히\n대회에 늦지 않게 도착할 수 있겠어",
    "episode_event_8070_zagirl_and_gai/4002_1001_400_10": "도움이 돼서 다행이네요",
    "episode_event_8070_zagirl_and_gai/4002_1001_500_10": "앗! 다행이다! 단델님\n근처까지 와 계셨군요!",
    "episode_event_8070_zagirl_and_gai/4002_1001_600_10": "좀처럼 안 오시길래\n호브가 찾으러 갔었어요",
    "episode_event_8070_zagirl_and_gai/4002_1001_700_10": "단델이라면... 가라르지방에 있다는\n그 엄청난 실력의 트레이너이신가요!?",
    "episode_event_8070_zagirl_and_gai/4002_1001_800_10": "저도 이름을 들어 봤어요!",
    "episode_event_8070_zagirl_and_gai/4002_1001_900_10": "하하하! 그거 영광인걸!",
    "episode_event_8070_zagirl_and_gai/4002_1001_1000_10": "두 사람은 칼로스지방의\n미르시티에서 왔다 그랬지?",
    "episode_event_8070_zagirl_and_gai/4002_1001_1100_10": "그쪽에 있는 세레나와 칼름도\n칼로스지방 출신이야!",
    "episode_event_8070_zagirl_and_gai/4002_1001_1200_10": "오...! 미르에서 왔다니",
    "episode_event_8070_zagirl_and_gai/4002_1001_1300_10": "설마 이런 곳에서\n같은 지방 사람을 만날 줄은 몰랐어",
    "episode_event_8070_zagirl_and_gai/4002_1001_1400_10": "우리한테도 미르시티는\n수많은 추억이 있는 장소야",
    "episode_event_8070_zagirl_and_gai/4002_1001_1500_10": "요즘은 와일드 존이 늘어나서\n당혹스러워하는 사람도 있는데...\n두 사람은 받아들인 쪽이야?",
    "episode_event_8070_zagirl_and_gai/4002_1001_1600_10": "어... 와일드 존?\n그게 뭐야?",
    "episode_event_8070_zagirl_and_gai/4002_1001_1700_10": "설마 뭔지 몰라...!?",
    "episode_event_8070_zagirl_and_gai/4002_1001_1800_10": "미르에 왔는데 와일드 존을\n못 봤다는 건 말이 안 되는데...?",
    "episode_event_8070_zagirl_and_gai/4002_1001_1900_10": "참고로 세레나와 칼름은\n우수한 트레이너이기도 해",
    "episode_event_8070_zagirl_and_gai/4002_1001_2000_10": "오늘 대회에도 참가할 거지?",
    "episode_event_8070_zagirl_and_gai/4002_1001_2100_10": "네! 친구들하고 다 같이 나갈 거예요!",
    "episode_event_8070_zagirl_and_gai/4002_1001_2200_10": "그 정도로 실력에 자신이 있다면\n언젠가 \"ZA로열\"에서\n만나게 될지도 모르겠네",
    "episode_event_8070_zagirl_and_gai/4002_1001_2300_10": "ZA로열...?",
    "episode_event_8070_zagirl_and_gai/4002_1001_2400_10": "어라? 이것도 몰라?",
    "episode_event_8070_zagirl_and_gai/4002_1001_2500_10": "뭔가 이상한데...\n이야기가 맞물리질 않아",
    "episode_event_8070_zagirl_and_gai/4002_1001_2600_10": "...설마",
    "episode_event_8070_zagirl_and_gai/4002_1001_2700_10": "응... 나도 같은 생각이 든 참이었어",
    "episode_event_8070_zagirl_and_gai/4002_1001_2800_10": "이건 추측이지만 두 사람이 아는 미르시티와\n우리가 아는 미르시티는\n조금 다를지도 모르겠어...",
    "episode_event_8070_zagirl_and_gai/4002_1001_2900_10": "미르시티가 서로 달라...?",
    "episode_event_8070_zagirl_and_gai/4002_1001_3000_10": "파시오에는 다른 시공이나\n시대에서 찾아온 사람과 포켓몬이 있거든",
    "episode_event_8070_zagirl_and_gai/4002_1001_3100_10": "그래서 우리가 아는\n미르시티와는 또 다른\n미르시티가 아닐까 싶었어",
    "episode_event_8070_zagirl_and_gai/4002_1001_3200_10": "충분히 그럴 수 있을 거 같네",
    "episode_event_8070_zagirl_and_gai/4002_1001_3300_10": "내 주변에도\n그런 경험을 한 사람들이 있거든",
    "episode_event_8070_zagirl_and_gai/4002_1001_3400_10": "믿기 어려운 이야기이긴 하지만...",
    "episode_event_8070_zagirl_and_gai/4002_1001_3500_10": "우리도 MZ단 활동을 하면서\n신비한 의뢰들을 완수해 왔으니 뭐...",
    "episode_event_8070_zagirl_and_gai/4002_1001_3600_10": "그런 일도 있을 수 있는 건가 하고\n받아들이게 되네",
    "episode_event_8070_zagirl_and_gai/4002_1001_3700_10": "맞아, 이렇게 된 이상\n뭐든 상관없어!",
    "episode_event_8070_zagirl_and_gai/4002_1001_3800_10": "그나저나 단델님,\n이야기를 실컷 한 건 좋은데\n시간은 괜찮으세요...?",
    "episode_event_8070_zagirl_and_gai/4002_1001_3900_10": "큰일이다!\n슬슬 가지 않으면 늦겠어!",
    "episode_event_8070_zagirl_and_gai/4002_1001_4000_10": "그럼 서두르죠!",
    "episode_event_8070_zagirl_and_gai/4003_1101_100_20": "살짝 늦어 버렸지만\n무사히 단델을 회장까지 안내한 일행",
    "episode_event_8070_zagirl_and_gai/4003_1101_200_20": "하지만 어쩐지 장내가 소란스러웠는데...",
    "episode_event_8070_zagirl_and_gai/4003_1001_100_10": "저 사람들은...!?",
    "episode_event_8070_zagirl_and_gai/4003_1001_200_10": "저 녀석들은 로켓단이라고 해",
    "episode_event_8070_zagirl_and_gai/4003_1001_300_10": "사람과 포켓몬들에게\n나쁜 짓을 하는 사람들이야",
    "episode_event_8070_zagirl_and_gai/4003_1001_400_10": "거침없이\n도둑질이나 위협 같은 악행을\n반복하고 있지",
    "episode_event_8070_zagirl_and_gai/4003_1001_500_10": "그런 악당이 있었다니...!",
    "episode_event_8070_zagirl_and_gai/4003_1001_600_10": "대체 무슨 목적으로 여기에...",
    "episode_event_8070_zagirl_and_gai/4003_1001_700_10": "잠깐만!\n저기 보이는 사람...",
    "episode_event_8070_zagirl_and_gai/4003_1001_800_10": "지난번에 내 연구소에 숨어들어 와서\n데이터를 훔친 건 너희들이었구나?",
    "episode_event_8070_zagirl_and_gai/4003_1001_900_10": "그러면 이제 와서 굳이 날\n납치할 필요는 없지 않을까~?",
    "episode_event_8070_zagirl_and_gai/4003_1001_1000_10": "흐흥, 태연한 척하기는!",
    "episode_event_8070_zagirl_and_gai/4003_1001_1100_10": "그래, 메가진화의 연구 데이터를\n훔친 건 우리 로켓단!",
    "episode_event_8070_zagirl_and_gai/4003_1001_1200_10": "덕분에 \"재미있는 일\"을 할 수 있게 되었거든",
    "episode_event_8070_zagirl_and_gai/4003_1001_1300_10": "너는 이 머신의 완성도를\n높이는 데 협력해 줘야겠어",
    "episode_event_8070_zagirl_and_gai/4003_1001_1400_10": "\"강제 메가진화 머신\"\n스위치 온!",
    "episode_event_8070_zagirl_and_gai/4004_1001_100_10": "어떻게 이런 짓을...",
    "episode_event_8070_zagirl_and_gai/4004_1001_200_10": "포켓몬을 강제로\n메가진화하게 하다니...!",
    "episode_event_8070_zagirl_and_gai/4004_1001_300_10": "와하하하!\n멋진 힘이로군!",
    "episode_event_8070_zagirl_and_gai/4004_1001_400_10": "키스톤도 메가스톤도 없이\n메가진화를 시킨 거야?",
    "episode_event_8070_zagirl_and_gai/4004_1001_500_10": "...아마 버디스톤을 악용한 걸 거야",
    "episode_event_8070_zagirl_and_gai/4004_1001_600_10": "버디스톤이면...\n폴리곤폰에 내장되어 있는 돌을\n말씀하시는 거죠?",
    "episode_event_8070_zagirl_and_gai/4004_1001_700_10": "맞아, 버디즈의 유대를\n힘으로 바꾸는 신비한 돌인데...",
    "episode_event_8070_zagirl_and_gai/4004_1001_800_10": "메가진화랑 그 외의\n특별한 현상도 일으킬 수 있어",
    "episode_event_8070_zagirl_and_gai/4004_1001_900_10": "그런 엄청난 물건이었단 말이야...?",
    "episode_event_8070_zagirl_and_gai/4004_1001_1000_10": "메가진화는 원래\n트레이너가 지닌\n\"키스톤\"과...",
    "episode_event_8070_zagirl_and_gai/4004_1001_1100_10": "포켓몬이 지닌\n\"메가스톤\"이 공명해서\n일어나는 현상이지만",
    "episode_event_8070_zagirl_and_gai/4004_1001_1200_10": "그뿐 아니라 트레이너와\n포켓몬 사이에 강한 유대가 필요해",
    "episode_event_8070_zagirl_and_gai/4004_1001_1300_10": "맞아, 그렇게 포켓몬이\n갖고 있던 파워를\n일시적으로 해방해서",
    "episode_event_8070_zagirl_and_gai/4004_1001_1400_10": "일반적인 진화를 넘어선\n파워 업을 해내는 거잖아?",
    "episode_event_8070_zagirl_and_gai/4004_1001_1500_10": "버디스톤으로 하는\n메가진화도 강한 유대는 반드시 필요해",
    "episode_event_8070_zagirl_and_gai/4004_1001_1600_10": "로켓단이 그런 유대를\n맺었을 거라는 생각은 안 드는데...",
    "episode_event_8070_zagirl_and_gai/4004_1001_1700_10": "하지만... 유대가 필요하지 않은\n메가진화라면 어떨까?",
    "episode_event_8070_zagirl_and_gai/4004_1001_1800_10": "로켓단 보스 비주기...!",
    "episode_event_8070_zagirl_and_gai/4004_1001_1900_10": "플라타느박사님을 풀어 줘!",
    "episode_event_8070_zagirl_and_gai/4004_1001_2000_10": "그건 불가능한 요구로군",
    "episode_event_8070_zagirl_and_gai/4004_1001_2100_10": "나는 모든 부하들이\n메가진화라는 힘의 위대함을\n맛봤으면 하거든",
    "episode_event_8070_zagirl_and_gai/4004_1001_2200_10": "그래서 유대 없이도\n메가진화를 할 수 있게 만드는\n장치를 개발했지만...",
    "episode_event_8070_zagirl_and_gai/4004_1001_2300_10": "아직은 불안정해서\n플라타느박사의 협력이 필요하단 거다",
    "episode_event_8070_zagirl_and_gai/4004_1001_2400_10": "하지만 그런 메가진화는\n포켓몬을 괴롭게 할 뿐이에요!",
    "episode_event_8070_zagirl_and_gai/4004_1001_2500_10": "맞아! 그런 방식은\n폭주 메가진화하고 다를 게 없잖아!",
    "episode_event_8070_zagirl_and_gai/4004_1001_2600_10": "폭주 메가진화...?",
    "episode_event_8070_zagirl_and_gai/4004_1001_2700_10": "메가파워의 영향을 받은\n야생 포켓몬이...",
    "episode_event_8070_zagirl_and_gai/4004_1001_2800_10": "원하지 않는 형태로 메가진화해 버리는\n이상 현상을 말하는 거야",
    "episode_event_8070_zagirl_and_gai/4004_1001_2900_10": "호오...?",
    "episode_event_8070_zagirl_and_gai/4004_1001_3000_10": "우리 MZ단이 중심이 되어서\n폭주 메가진화를 일으킨 포켓몬들을\n진정시키곤 했어",
    "episode_event_8070_zagirl_and_gai/4004_1001_3100_10": "그러니 인간이 좋자고 억지로\n메가진화를 시키는 건 용납할 수 없어요!",
    "episode_event_8070_zagirl_and_gai/4004_1001_3200_10": "모두들! 로켓단을 막기 위해 힘을 빌려줘!",
    "episode_event_8070_zagirl_and_gai/4004_1001_3300_10": "물론이지!\n이런 악행을 두고 보진 않아!",
    "episode_event_8070_zagirl_and_gai/4005_1001_100_10": "과연 가라르지방의 챔피언...이라고\n칭찬해 주고 싶은 장면이다만",
    "episode_event_8070_zagirl_and_gai/4005_1001_200_10": "플라타느박사가 우리의 손안에\n있다는 사실을 잊어선 곤란하지",
    "episode_event_8070_zagirl_and_gai/4005_1001_300_10": "큭...!",
    "episode_event_8070_zagirl_and_gai/4005_1001_400_10": "박사님을 방패로 쓰다니...!",
    "episode_event_8070_zagirl_and_gai/4005_1001_500_10": "이러면 단델님도\n전력을 다해 싸울 수가 없어...!",
    "episode_event_8070_zagirl_and_gai/4005_1001_600_10": "좋지 않아...\n이대로 가면 지게 될 거야",
    "episode_event_8070_zagirl_and_gai/4005_1001_700_10": "수많은 트레이너와\n메가진화 포켓몬...",
    "episode_event_8070_zagirl_and_gai/4005_1001_800_10": "...있잖아, 가이!\n지금 이거, 평소의 우리들하고\n상황이 비슷한 거 같지 않아?",
    "episode_event_8070_zagirl_and_gai/4005_1001_900_10": "뭐...? 그게 무슨 소리야?",
    "episode_event_8070_zagirl_and_gai/4005_1001_1000_10": "ZA로열 말이야!",
    "episode_event_8070_zagirl_and_gai/4005_1001_1100_10": "미르시티에서도\n수많은 트레이너를 상대로\n이겨 왔잖아?",
    "episode_event_8070_zagirl_and_gai/4005_1001_1200_10": "듣고 보니 그렇네",
    "episode_event_8070_zagirl_and_gai/4005_1001_1300_10": "그러니까 이런 작전은 어떨까?",
    "episode_event_8070_zagirl_and_gai/4005_1001_1400_10": "...오오!\n그거 좋은 생각인데?",
    "episode_event_8070_zagirl_and_gai/4005_1001_1500_10": "거기 두 사람도\n잠깐 우리 이야기 좀 들어 봐",
    "episode_event_8070_zagirl_and_gai/4005_1001_1600_10": "...좋아\n그 작전으로 가자",
    "episode_event_8070_zagirl_and_gai/4005_1001_1700_10": "꼭 성공시키자!",
    "episode_event_8070_zagirl_and_gai/4005_1001_1800_10": "가이, 준비 다 됐어!",
    "episode_event_8070_zagirl_and_gai/4005_1001_1900_10": "그러면 작전을 시작하자!",
    "episode_event_8070_zagirl_and_gai/4005_1001_2000_10": "MZ단으로서 평소처럼...",
    "episode_event_8070_zagirl_and_gai/4005_1001_2100_10": "사람과 포켓몬을 돕는 거야!",
    "episode_event_8070_zagirl_and_gai/4005_1001_2200_10": "이제 그만해! 로켓단!",
    "episode_event_8070_zagirl_and_gai/4005_1001_2300_10": "계속 제멋대로 굴기나 하고 말이야!\n우리도 이제 더는 못 참아!",
    "episode_event_8070_zagirl_and_gai/4005_1001_2400_10": "머리끝까지 화가 났나 본데?",
    "episode_event_8070_zagirl_and_gai/4005_1001_2500_10": "인질이 있다는 걸 잊은 건 아니겠지?",
    "episode_event_8070_zagirl_and_gai/4005_1001_2600_10": "그 이상 날뛰면 박사한테\n무슨 일이 생겨도 우린 모른다고!",
    "episode_event_8070_zagirl_and_gai/4005_1001_2700_10": "더러운 수작을 부리다니!\n정정당당하게 승부해!",
    "episode_event_8070_zagirl_and_gai/4005_1001_2800_10": "헤헤헤... 로켓단에게 반항하면\n이렇게 되는 거라고",
    "episode_event_8070_zagirl_and_gai/4005_1001_2900_10": "언제 내 등 뒤에!?",
    "episode_event_8070_zagirl_and_gai/4005_1001_3000_10": "앞만 보니까 그렇게 되는 거야!",
    "episode_event_8070_zagirl_and_gai/4005_1001_3100_10": "괜찮으세요?",
    "episode_event_8070_zagirl_and_gai/4005_1001_3200_10": "덕분에 살았구나! 고마워!",
    "episode_event_8070_zagirl_and_gai/4005_1001_3300_10": "좋아! 작전 성공이다!",
    "episode_event_8070_zagirl_and_gai/4005_1001_3400_10": "박사님은 저희가 안전한 곳으로 모실게요!",
    "episode_event_8070_zagirl_and_gai/4005_1001_3500_10": "거, 거기 서~!",
    "episode_event_8070_zagirl_and_gai/4005_1001_3600_10": "이봐...\n한눈팔아도 괜찮겠어?",
    "episode_event_8070_zagirl_and_gai/4006_1001_100_10": "호오...!",
    "episode_event_8070_zagirl_and_gai/4006_1001_200_10": "두 사람 다 제법인데!",
    "episode_event_8070_zagirl_and_gai/4006_1001_300_10": "그렇다면 이쪽도 진심을 보여 주마",
    "episode_event_8070_zagirl_and_gai/4006_1001_400_10": "뮤츠! 메가진화!",
    "episode_event_8070_zagirl_and_gai/4006_1001_500_10": "...미안해, 리자몽\n지금까지 잘 버텨 줬어",
    "episode_event_8070_zagirl_and_gai/4006_1001_600_10": "강제 메가진화가 아니야...!?",
    "episode_event_8070_zagirl_and_gai/4006_1001_700_10": "로켓단에도 유대는 있는 법이거든",
    "episode_event_8070_zagirl_and_gai/4006_1001_800_10": "순수한 \"악의 유대\"가!",
    "episode_event_8070_zagirl_and_gai/4006_1001_900_10": "악의 유대...",
    "episode_event_8070_zagirl_and_gai/4006_1001_1000_10": "그게 우리들의 유대보다\n강하기라도 하단 거야?",
    "episode_event_8070_zagirl_and_gai/4006_1001_1100_10": "보여 주자!\nMZ단 리더와 비밀 병기의 실력을!",
    "episode_event_8070_zagirl_and_gai/4006_1001_1200_10": "장크로다일! 메가진화!",
    "episode_event_8070_zagirl_and_gai/4006_1001_1300_10": "우리도 가자!\n메가진화해, 메가니움!",
    "episode_event_8070_zagirl_and_gai/4007_1001_100_10": "장크로다일과 메가니움이\n메가진화...!?",
    "episode_event_8070_zagirl_and_gai/4007_1001_200_10": "놀라운걸...\n지금껏 본 적이 없는 모습이야!",
    "episode_event_8070_zagirl_and_gai/4007_1001_300_10": "슬슬 포기하시지",
    "episode_event_8070_zagirl_and_gai/4007_1001_400_10": "우리 MZ단이 있는 한...",
    "episode_event_8070_zagirl_and_gai/4007_1001_500_10": "그 어떤 사람과 포켓몬도\n괴롭히게 두지 않을 거야!",
    "episode_event_8070_zagirl_and_gai/4007_1001_600_10": "제법이구나...!",
    "episode_event_8070_zagirl_and_gai/4007_1001_700_10": "...메가진화는 정말 심오하군",
    "episode_event_8070_zagirl_and_gai/4007_1001_800_10": "오늘은 이만 손을 떼도록 하지\n폭주 메가진화라는\n흥미로운 이야기도 들었으니 말이야",
    "episode_event_8070_zagirl_and_gai/4007_1001_900_10": "우리의 강제 메가진화가 지닌\n가능성과 미래가 보였다",
    "episode_event_8070_zagirl_and_gai/4008_1001_100_10": "다시 한번...\n대회 시작 시간에 늦어 버려서\n정말 미안해!",
    "episode_event_8070_zagirl_and_gai/4008_1001_200_10": "로켓단이 저지른 악행에 대해서는\n이미 알고 있지?",
    "episode_event_8070_zagirl_and_gai/4008_1001_300_10": "하지만 그 모든 것은\n이곳에 있는 용기 있는 트레이너!",
    "episode_event_8070_zagirl_and_gai/4008_1001_400_10": "새아와 가이 일행의 협력 덕분에\n해결되었어!",
    "episode_event_8070_zagirl_and_gai/4008_1001_500_10": "그 힘, 이번엔 직접 볼 수 있을까?",
    "episode_event_8070_zagirl_and_gai/4008_1001_600_10": "기꺼이 보여 드려야죠!",
    "episode_event_8070_zagirl_and_gai/4008_1001_700_10": "져 드리진 않을 거예요!",
    "episode_event_8070_zagirl_and_gai/4008_1001_800_10": "당연히 그렇게 나와야지!",
    "episode_event_8070_zagirl_and_gai/4008_1001_900_10": "자! 챔피언 타임을 즐겨보자!",
    "episode_event_8070_zagirl_and_gai/4009_1101_100_20": "대회가 끝난 후...",
    "episode_event_8070_zagirl_and_gai/4009_1001_100_10": "오늘 하루는 많은 일이 있었네",
    "episode_event_8070_zagirl_and_gai/4009_1001_200_10": "응, 가볍게 관광을 즐길 생각이었는데...",
    "episode_event_8070_zagirl_and_gai/4009_1001_300_10": "설마 메가진화를 악용하는\n조직과 싸우게 될 줄은 몰랐어",
    "episode_event_8070_zagirl_and_gai/4009_1001_400_10": "저런 녀석들은\n로켓단 말고도 더 있어",
    "episode_event_8070_zagirl_and_gai/4009_1001_500_10": "언제 또 무시무시한 사건이\n일어날지 모른다는 말이네요",
    "episode_event_8070_zagirl_and_gai/4009_1001_600_10": "...가이\n나, 파시오에 좀 더 남아 있고 싶어",
    "episode_event_8070_zagirl_and_gai/4009_1001_700_10": "또 사건이 일어났을 때\n사람들을 돕고 싶거든!",
    "episode_event_8070_zagirl_and_gai/4009_1001_800_10": "별일이네\n나도 같은 생각을 하던 중이었어",
    "episode_event_8070_zagirl_and_gai/4009_1001_900_10": "그래 주면 정말 든든할 거야!",
    "episode_event_8070_zagirl_and_gai/4009_1001_1000_10": "메가진화와 관련된 이야기도\n듣고 싶고 말이야!",
    "episode_event_8070_zagirl_and_gai/4009_1001_1100_10": "음! 새로운 동료도 늘어났으니...",
    "episode_event_8070_zagirl_and_gai/4009_1001_1200_10": "기념으로 호텔Z의 인기 메뉴인\n크루아상 카레를 대접할게요!",
    "episode_event_8070_zagirl_and_gai/4009_1001_1300_10": "카레라니! 그거 기대되는데!",
    "episode_event_8070_zagirl_and_gai/4009_1001_1400_10": "크루아상에 카레...?",
    "episode_event_8070_zagirl_and_gai/4009_1001_1500_10": "어떤 요리일지 상상이 안 돼...",
    "episode_event_8070_zagirl_and_gai/4009_1001_1600_10": "너희 둘이 있던 미르시티에서는\n그게 명물이었던 거니?",
    "episode_event_8070_zagirl_and_gai/4009_1001_1700_10": "후훗, 그런 건 아닌데요...",
    "episode_event_8070_zagirl_and_gai/4009_1001_1800_10": "아무튼 드셔 보시면 알 거예요!",
    "episode_event_8070_zagirl_and_gai/4009_1001_1900_10": "조만간 파시오에서도\n인기 메뉴가 될 거라고요!"
}
