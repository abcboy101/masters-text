{
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1101_100_20": "어느 날...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_100_10": "같이 장을 봐 줘서\n고마워, [Name:PlayerNickname ]",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_200_10": "재료는 모였으니까\n이제 요리를 만들 거야!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_300_10": "뭐?\n어떤 요리를 만들 거냐고?",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_400_10": "그거야 당연히...\n가이 특제 크루아상 카레지!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_500_10": "파시오에도 신세를 진 사람들이\n많이 생겼으니까 은혜를 갚기 위해서\n대접할 생각이야",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_600_10": "...그리고, 하나 더",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_700_10": "파시오의 사람들을 위해\n하고 싶은 일이 있거든",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_800_10": "파시오에 버디즈들이\n묵을 수 있는 호텔을\n언젠가 만들고 싶어",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_900_10": "이곳에는 MZ단 말고도\n사람을 돕는 트레이너들이 많잖아?",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1000_10": "나도 미르시티에서는\n호텔Z에 신세를 지면서\n여러 도움을 받았으니까...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1100_10": "파시오에 온 버디즈들이\n누구나 여유롭게 쉴 수 있는 장소가\n있으면 좋겠다는 생각이 들었어",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1200_10": "그래서 말인데, 파시오에 호텔을 만들면\n[Name:PlayerNickname ]도 도와주지 않을래?",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0301_100_10": "당연히 돕겠다고 한다",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0401_100_10": "그렇게 망설이지 않고\n받아들여 주는 점은 역시 대단한걸!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0302_100_10": "보상에 따라서라고 농담을 한다",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0402_100_10": "어떤 보상을 받게 될지는\n너 하기 나름이야",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1300_10": "뭐, 정말로 실현하는 데까지는\n시간이 필요하겠지만 말이야...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1400_10": "아무튼 오늘은 고마웠어!\n보답할 테니까 기대해 줘!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1101_100_20": "가이와 함께 장을 본 후\n얼마 뒤...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_100_10": "갑자기 미안한데\n혹시 내일 일정 있어?",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_200_10": "없으면 그대로 비워 둬!\n그때의 보답을 하고 싶어서 그래!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1101_200_20": "가이가 지정한\n장소로 가 보니...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_300_10": "손님, 호텔Z 파시오에\n방문해 주셔서 감사합니다",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_400_10": "손님께서는 오늘 하루 동안\n저희 호텔의 유일한 손님이십니다\n부디 편안하게 즐겨 주시길",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_500_10": "...놀랐어?",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_600_10": "전에 말한 호텔 계획이야!\n라이어씨를 상대로\n시범 운영을 해 보기로 했거든",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_700_10": "이름은 당연히 호텔Z!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_800_10": "미르시티에서\n나를 도와준 호텔Z처럼...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_900_10": "내 호텔이\n많은 사람들을 지탱해 준다면\n좋겠다는 생각이야",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1000_10": "언젠가 정말로 파시오에서\n호텔Z를 열게 된다면",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1100_10": "[Name:PlayerNickname ][Kor:Particle char=\"ga\" ] 첫 번째\n손님이 되어 줬으면 해",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0301_100_10": "멋진 생각이라며 칭찬한다",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0401_100_10": "그렇지? 너라면\n그렇게 말할 거라고 생각했어!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0302_100_10": "첫 번째 손님이라니 영광이라며 기뻐한다",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0402_100_10": "그렇게 말한다면\n나도 더 열심히 해야겠는걸!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1200_10": "오늘은 일단 시범 운영이지만...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1300_10": "네가 응원해 준다면\n파시오의 호텔Z를\n실현시킬 수 있을 거라고 확신해",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1400_10": "그러니까 앞으로도 잘 부탁할게!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1500_10": "좋아, 의욕이 생긴 김에\n바로 접객을 해 볼까!",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1600_10": "같이 장을 봐 준 보답으로\n자신 있는 요리를 만들어 봤어",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1700_10": "그럼...",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1800_10": "저희 호텔이 자랑하는\n크루아상 카레입니다\n마음껏 즐겨 주시기 바랍니다"
}
