{
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1101_100_20": "ポケモン勝負を　していた\n[Name:PlayerNickname ]と　アカネ",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1101_200_20": "その結果……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_100_10": "うぐぅ……\nうちの　負けやな",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_200_10": "ぐ……　ぐっすん……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0301_100_10": "強かったよ　と伝える",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0401_100_10": "な……　なぐさめて　もらわんでも\n大丈夫！　心配いらんよ！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0302_100_10": "大丈夫？　と心配する",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0402_100_10": "決まっとるやろ！\n心配せんでも　大丈夫やから！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_300_10": "悔しいと　泣いてまうけど……\nいつまでも　泣いてられへんもん！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_400_10": "あー　負けた　負けた！\nうちの　完敗やー！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_500_10": "ほんま　[Name:PlayerNickname ]は\n強い　トレーナーやな！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_600_10": "パシオには　あんたみたいな\n強い人が　いっぱい　おるし……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_700_10": "ポケモン勝負　挑んでも\n勝って　負けての　繰り返しや！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_800_10": "そんでも　負けたら\nめっちゃ　悔しいけど……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_900_10": "泣きそうに　なるのも　少しずつ\n我慢できるように　なってきたで！\nこれも　[Name:PlayerNickname ]の　おかげや！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1000_10": "あんたと　なんべんも\n勝負してきた　経験が……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1100_10": "トレーナーとしての　腕前も　精神も\n鍛えあげたんやで！　きっと！\nありがとな！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0301_200_10": "どういたしまして　と伝える",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0401_200_10": "せや！　感謝の　言葉は\n素直に　受け取っとき！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0302_200_10": "もっと　鍛えてあげるよ　と笑う",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0402_200_10": "なんやねん！\n調子のええ　やっちゃなー！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1200_10": "今日は　あんたに　してやられたけど\n負けっぱなしじゃ　いられへん！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1300_10": "勝負のお礼も　兼ねて\nきっちり　返したるから\n覚悟しといてや！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1101_100_20": "後日……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1101_200_20": "[Name:PlayerNickname ]は\nアカネに　誘われ\nとある場所に　来ていた……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_100_10": "いつかの　お礼に　コーヒーでも\nごちそうしようかと　思ってな！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_200_10": "ここなー　特別に苦い\n「大人の味」の　コーヒーを\nだすことで　有名やねん！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_300_10": "うちは　その　大人の味に\n挑戦する　つもりやけど……\n[Name:PlayerNickname ]は　どうする？",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_400_10": "ミルクたっぷりの　コーヒーも\nあるみたいやで",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0301_100_10": "同じものがいい　という",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0401_100_10": "おおーっ？\nアカネちゃんに　はりあう気やなー！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0302_100_10": "本当に飲めるのか　きく",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0402_100_10": "失礼な　やっちゃなー！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0402_200_10": "この　アカネちゃんを\n甘くみたら　アカンで！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_500_10": "……よっしゃ！　どっちが\nより　大人の舌か　勝負や！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_600_10": "うぐぅ……　に　苦い……\nこれは　想像以上や……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_700_10": "うちらには　まだ　はやかったかもなあ\nとはいえ　残すのもあかんし……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0301_200_10": "砂糖を入れよう　と提案する",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0401_200_10": "……そやな\nそれなら　いけそうや！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0302_200_10": "ミルクを入れよう　と提案する",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0402_300_10": "……そやな\n無理するのも　あかん！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_800_10": "なんなら　砂糖とミルク\n両方入れて　飲みやすくしよか！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1101_300_20": "ふたりで　コーヒーに\n砂糖とミルクを　入れて　飲んだ……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_900_10": "ふぅ……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1000_10": "甘くて　マイルドな\n飲みやすいコーヒーに　なったわ！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1100_10": "今回の勝負は　引き分けやったけど\nめっちゃ　楽しかったで！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1200_10": "そや！　勝負後の一杯に\nこれ飲まへん？",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1300_10": "じゃーん！　モーモーミルク！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1400_10": "[Name:PlayerNickname ]と　飲みたくて\n持ってきたんやで",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1500_10": "コーヒーも　ええけど\nやっぱ　モーモーミルク飲まんと\nうち　落ち着かへんねん！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1600_10": "それにしても　あんたとおると\nポケモン勝負以外でも　新しい経験が\nできて　めっちゃ　楽しいわ！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1700_10": "なあ　[Name:PlayerNickname ]！\nこれからも　ふたりで　いっぱい\nおもろいこと　しような！"
}
