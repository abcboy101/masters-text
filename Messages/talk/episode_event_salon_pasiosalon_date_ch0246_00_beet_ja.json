{
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0100_20": "ブレイク団たちと　戦う\nビートを　みかけた\n[Name:PlayerNickname ]",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0200_20": "ビートに　加勢しようと\n勝負に　参戦した",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0300_10": "……なんのつもりかは　わかりませんが",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0400_10": "加勢すると　いうなら\n足を　引っ張らないでくださいよ",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0500_20": "ビートと　協力して\nブレイク団を　撃退した……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0600_10": "……乱入パフォーマンスとしては\nまあまあ　だったんじゃないですか？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0700_10": "ぼくには　及びませんけどね",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0800_10": "前に　話したかも　しれませんが……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0900_10": "腕を試す　練習台として\nたまに　連中の相手を　してるんです",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1000_10": "もちろん　ひとりで　ですよ？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1100_10": "ぼくは　ひとりでも　十分に\nやっていける　実力が　あります",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1200_10": "だから　人の力を　借りる\n必要など　ないんですよ",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0301_1300_10": "ポプラのことを話す",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0401_1400_10": "なっ！？　どうして　そこで\nバアさんの　名前が！？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0302_1500_10": "ユウリたちのことを話す",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0402_1600_10": "……ぼくが　あの人たちを\n頼っているとでも　いいたいんですか？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1700_10": "まあ　確かに\n以前よりは　多少ですが……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1800_10": "他者との　関わり方が\n変わってきたような気が\nしますが……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1900_10": "それは　きっと　あのバアさんが……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2000_10": "……余計なことを　しゃべり過ぎました",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2100_10": "ぼくは　この辺で　失礼しますよ",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2200_10": "もう少し　話を\nききたい　ですって？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2300_10": "これ以上　ぼくに\nつきまとう　気ですか？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2400_10": "……それでは　さきほどの　加勢を\nひとつ　あなたからの　借りとして",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2500_10": "[Name:PlayerNickname ]さんの　ことを\n少し　鍛えてあげると　しましょうか",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1101_0100_20": "ビートとの　特訓が　終わった……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0200_10": "おやおや　この程度で\nもう　おつかれとは……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0300_10": "勝ち続けて　いたいのなら\n弱みは　みせるべきでは　ありませんよ",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0400_10": "あなたは　相手のことを\n気にかけ過ぎ　なんですよ\nそういうところが　隙になります",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0500_10": "……いや",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0600_10": "そういう　ぼくも　あなたに\nいろいろと　手を貸したことが\nありましたね",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0700_10": "人を助けるのは　悪いことじゃない\nですって？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0800_10": "いいえ　それは　違います",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0900_10": "仮にもし　あなたが　どうしようもなく\n打ちのめされたとき……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1000_10": "自分の力で　立ちあがることが\nできなくなって　しまったら\nどうするんです？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1100_10": "……ぼくも　かつて\n自分が　信じた道を\nくじかれた経験が　あります",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1200_10": "一度は　希望を　失いましたが……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1300_10": "それでも　新しい光を\nみつけられたと　思ってますよ",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1400_10": "立ちあがるのに\n他者の力が　あったとしても",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1500_10": "それでも　やはり……\nぼくが　信じるのは　自分自身です",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1600_10": "これからも　自分が　決めた道を\n生きていくことには　変わりません",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1700_10": "ぼくには　決して　揺るがない\n未来が　みえていますからね",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1800_10": "さて　立ち話は\nこれくらいに　しましょうか",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1900_10": "ぼくは　そろそろ　帰ります",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0301_2000_10": "同じ道で帰る　という",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0401_2100_10": "……お断りします\n一緒に　なんて　帰ったら\nなれあってるみたいじゃないですか",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0302_2200_10": "別々に帰るのかと　残念そうにいう",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0402_2300_10": "なんですか　その残念そうな　顔は？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2400_10": "ぼくは　ぼくの道を\nあなたは　あなたの道を　いきましょう",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2500_10": "近いうち　ぼくにしかない力で……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2600_10": "世界を　ビートの色に\n染めあげて　みせるから\n楽しみに　していなさい"
}
