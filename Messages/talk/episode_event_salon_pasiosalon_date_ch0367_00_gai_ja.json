{
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1101_100_20": "とある日……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_100_10": "買い物に　つきあってくれて\nサンキューな　[Name:PlayerNickname ]",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_200_10": "材料は　そろったから\n次は　料理を　作るぜ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_300_10": "えっ？\nどんな料理を　作るつもりなのかって？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_400_10": "そりゃ　もちろん……\nガイ特製　クロワッサンカレーだ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_500_10": "パシオでも　世話になった人が\nたくさんできたから　恩返しとして\nふるまいたくてさ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_600_10": "……あと　もうひとつ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_700_10": "パシオの　人たちのために\nやりたいことが　あるんだ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_800_10": "パシオで　バディーズたちが\n泊まれる　ホテルを\nいつか　作れないかな　って",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_900_10": "ここには　エムゼット団以外にも\n人助けをする　トレーナーが　多いだろ？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1000_10": "オレも　ミアレでは\nホテルＺに　世話になって\nいろいろと　救われたし……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1100_10": "パシオに来た　バディーズたち\nみんなが　ゆっくり　休める場所が\nあれば　いいなって",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1200_10": "だからさ　パシオで　ホテルを\n始めるときは　[Name:PlayerNickname ]も\n手伝って　くれないか？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0301_100_10": "もちろん！　と答える",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0401_100_10": "そうやって　迷わず\n引き受けてくれるところ\nさすがだぜ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0302_100_10": "報酬次第　と冗談で返す",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0402_100_10": "どんな　報酬に　なるかは\nオマエの　働き次第だぜ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1300_10": "まあ　実現するまでに\n時間は　かかるだろうけどさ……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1400_10": "ひとまず　今日は　サンキュー！\nお礼はするから　楽しみにしててくれ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1101_100_20": "ガイの　買い物を　手伝ってから\nしばらくして……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_100_10": "いきなりで　悪いけど\n明日の予定　空いてるか？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_200_10": "なければ　空けといてくれ！\nあのときの　お礼を　したいからさ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1101_200_20": "ガイから　指定された\n場所に　向かうと……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_300_10": "お客さま　ホテルＺパシオに\nおこしいただき　ありがとうございます",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_400_10": "本日は　お客さまの\n貸し切りと　なっておりますので\nどうぞ　ごゆっくり　お過ごしください",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_500_10": "……驚いたか？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_600_10": "前に　話した　ホテル計画！\nライヤーさんに　お試し体験を　させて\nもらえることに　なったんだ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_700_10": "名前は　もちろん　ホテルＺ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_800_10": "ミアレで　オレを\n助けてくれた　ホテルＺのように……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_900_10": "オレの　ホテルが\nたくさんの人の　支えになったら\nいいなって　思ってるんだ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1000_10": "いつか本当に　パシオで\nホテルＺを　オープンできたときにはさ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1100_10": "[Name:PlayerNickname ]が　最初の\nお客さまに　なってくれよ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0301_100_10": "素敵な考えだと　ほめる",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0401_100_10": "だろ？　オマエなら\nそういってくれると　思ったぜ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0302_100_10": "最初のお客様なんて光栄だと　喜ぶ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0402_100_10": "そういって　もらえると\nオレも　もっと　がんばれるぜ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1200_10": "今日は　ひとまず　お試しだけどさ……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1300_10": "オマエが　応援してくれるなら\nパシオの　ホテルＺは　きっと\n実現できるって　思ってる",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1400_10": "だから　これからも　よろしくな！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1500_10": "よし　気合いが　入ったところで\nおもてなしの　時間だ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1600_10": "この前の　お礼に\n得意料理を　作ったぜ",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1700_10": "それでは……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1800_10": "当ホテル　自慢の\nクロワッサンカレーで　ございます\nどうぞ　ご堪能くださいませ"
}
