{
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1101_100_20": "[Name:PlayerNickname ]與小茜\n正在打寶可夢對戰。",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1101_200_20": "對戰結果是……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_100_10": "嗚……\n人家輸了。",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_200_10": "嗚……嗚……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0301_100_10": "妳很強喔",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0401_100_10": "不……不用安慰我也沒關係！\n沒事的！[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]別擔心！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0302_100_10": "妳還好嗎？",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0402_100_10": "那還用說！\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]不用擔心，我沒事！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_300_10": "雖然我一不甘心就會哭……\n但總不能一直哭下去嘛！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_400_10": "啊～輸了輸了！\n人家徹底被打敗了～！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_500_10": "[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]真的是\n一位強大的訓練家呢！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_600_10": "帕希歐有好多像[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]這樣\n實力強大的訓練家……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_700_10": "即使向他們挑戰寶可夢對戰，\n我也是贏了又輸、輸了又贏！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_800_10": "但就算是這樣，\n輸了我還是會超不甘心……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_900_10": "不過我也開始慢慢地\n能夠忍住不要哭出來了！\n這都是[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的功勞喔！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1000_10": "跟[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]對戰過好幾次的經驗……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1100_10": "把我身為訓練家的實力與心態\n都給鍛鍊出來了！一定是這樣沒錯！\n謝謝[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0301_200_10": "不客氣",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0401_200_10": "就是這樣！\n人家跟[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]道謝就乖乖接受吧！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0302_200_10": "我會多多鍛鍊妳的",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_0402_200_10": "[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]說什麼！\n竟敢說這種大話～！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1200_10": "雖然我今天敗在[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的手上，\n但我可不會一直輸下去！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4001_1001_1300_10": "連同這次對戰的謝禮，\n我會一起好好奉還給[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的，\n做好心理準備吧！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1101_100_20": "幾天後……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1101_200_20": "[Name:PlayerNickname ]受到小茜的邀請，\n來到了某個地方……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_100_10": "我想說要請[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]喝杯咖啡，\n當作之前的謝禮！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_200_10": "這裡啊～有名的就是\n會提供特別苦、\n有著「成熟味道」的咖啡喔！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_300_10": "人家打算要挑戰一下\n那個成熟的味道……\n[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]呢？",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_400_10": "這裡好像也有加了\n很多鮮奶的咖啡喔。",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0301_100_10": "我要跟妳一樣的",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0401_100_10": "哦～？\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]想跟小茜我較量是吧～！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0302_100_10": "妳真的喝得下去嗎？",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0402_100_10": "真是沒禮貌～！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0402_200_10": "[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]可別小看小茜我喔！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_500_10": "……好！我們來比比看\n誰的味蕾比較成熟！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_600_10": "唔……好、好苦……\n比我想像中還要苦……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_700_10": "這對我們來說可能還太早了。\n不過也不能把它剩下來……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0301_200_10": "加點砂糖吧",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0401_200_10": "……說得也是。\n這樣應該就喝得下去了！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0302_200_10": "加點鮮奶吧",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_0402_300_10": "……說得也是。\n勉強自己喝也不好！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_800_10": "不然我們把砂糖和鮮奶都加進去，\n讓它變得順口一點吧！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1101_300_20": "兩人把砂糖和鮮奶\n加進咖啡後喝了下去……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_900_10": "呼……",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1000_10": "變成味道甘甜，\n口感溫和順口的咖啡了！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1100_10": "這次的比賽雖然打成了平手，\n但我覺得超級開心的喔！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1200_10": "對了！比完賽之後\n要不要喝杯這個呀？",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1300_10": "鏘鏘～！哞哞鮮奶！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1400_10": "我想和[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]一起喝，\n所以就帶來了。",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1500_10": "雖然咖啡也很不錯，\n但不喝哞哞鮮奶，\n人家果然還是會很不自在！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1600_10": "不過話說回來，和[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]在一起，\n除了寶可夢對戰之外，還體驗到了新鮮事，\n實在是有夠開心的！",
    "episode_event_salon_pasiosalon_date_ch0026_00_akane/4002_1001_1700_10": "我說，[Name:PlayerNickname ]！\n我們今後也要一起\n做很多有趣的事喔！"
}
