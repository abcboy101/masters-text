{
    "episode_event_8070_zagirl_and_gai/4001_1001_100_10": "パシオは　人工島って　きいてたけど\n案外　自然豊かな　ところなんだね！",
    "episode_event_8070_zagirl_and_gai/4001_1001_200_10": "ポケモンが　ストレスなく\n過ごせるようにって　工夫なのかもな",
    "episode_event_8070_zagirl_and_gai/4001_1001_300_10": "そのおかげか　どのポケモンも\nのびのびしているように　みえるぜ",
    "episode_event_8070_zagirl_and_gai/4001_1001_400_10": "オーダイルと　メガニウムも\n気に入ってくれると　いいね",
    "episode_event_8070_zagirl_and_gai/4001_1001_500_10": "さてと……\nせっかく　新しい街に　来たわけだし\nいろいろ　みて　回ろうぜ",
    "episode_event_8070_zagirl_and_gai/4001_1001_600_10": "うん　どこの　カフェに\nどんな　メニューがあるか　とか\nチェックして　おきたいし",
    "episode_event_8070_zagirl_and_gai/4001_1001_700_10": "お気に入りの　休憩スポットを\nみつけておくのは　大切だよな！",
    "episode_event_8070_zagirl_and_gai/4001_1001_800_10": "すまない！\nちょっと　道を　ききたいんだが……",
    "episode_event_8070_zagirl_and_gai/4001_1001_900_10": "えっ？",
    "episode_event_8070_zagirl_and_gai/4001_1001_1000_10": "アリーナが　どっちに　あるか\nわからないか？",
    "episode_event_8070_zagirl_and_gai/4001_1001_1100_10": "ポケモン勝負の　大会に\n出場する　予定なんだけど\n道に　迷ってしまってな",
    "episode_event_8070_zagirl_and_gai/4001_1001_1200_10": "このままだと　開始時間に\n間にあわないかも　しれないんだ",
    "episode_event_8070_zagirl_and_gai/4001_1001_1300_10": "それは　大変……！",
    "episode_event_8070_zagirl_and_gai/4001_1001_1400_10": "でも　わたしたちも\nパシオに　来たばかりで\nまだ　詳しくは……",
    "episode_event_8070_zagirl_and_gai/4001_1001_1500_10": "いいですよ　案内します",
    "episode_event_8070_zagirl_and_gai/4001_1001_1600_10": "本当か？　助かるぜ！",
    "episode_event_8070_zagirl_and_gai/4001_1001_1700_10": "ガイ……！\nそんな気軽に　引き受けて\n大丈夫なの？",
    "episode_event_8070_zagirl_and_gai/4001_1001_1800_10": "この　ポリゴンフォンさえ　あれば\nどうにか　なるって！",
    "episode_event_8070_zagirl_and_gai/4001_1001_1900_10": "まあ　地図が　わかれば\n大丈夫……　かな？",
    "episode_event_8070_zagirl_and_gai/4001_1001_2000_10": "それに　困ってる人を\nほうっておくわけにも　いかないし",
    "episode_event_8070_zagirl_and_gai/4001_1001_2100_10": "だろ？",
    "episode_event_8070_zagirl_and_gai/4001_1001_2200_10": "オレたちには　エムゼット団として\nミアレシティを　守ってきた\n経験が　あるんだ",
    "episode_event_8070_zagirl_and_gai/4001_1001_2300_10": "パシオでも　バッチリ\n「人助け」　しようぜ！",
    "episode_event_8070_zagirl_and_gai/6801_1031_100_10": "エムゼット団　登場！",
    "episode_event_8070_zagirl_and_gai/6801_1001_100_10": "この島でも　オレたちの力が\n必要な場面は　多そうだな",
    "episode_event_8070_zagirl_and_gai/6801_1001_200_10": "パシオでも　はりきって\n人助け　ポケモン助け　だね！",
    "episode_event_8070_zagirl_and_gai/6801_1001_300_10": "ああ　エムゼット団　リーダーと\n切り札の活躍　みてもらおうぜ",
    "episode_event_8070_zagirl_and_gai/4002_1001_100_10": "ポリゴンフォンに　よると\nこの道を　進めば　いいはずです",
    "episode_event_8070_zagirl_and_gai/4002_1001_200_10": "ありがとう　ふたりとも！",
    "episode_event_8070_zagirl_and_gai/4002_1001_300_10": "おかげで　どうにか\n大会に　間にあいそうだ",
    "episode_event_8070_zagirl_and_gai/4002_1001_400_10": "お役に立てて　よかったです",
    "episode_event_8070_zagirl_and_gai/4002_1001_500_10": "あっ！　よかった　ダンデさん\n近くまで　来てたんですね",
    "episode_event_8070_zagirl_and_gai/4002_1001_600_10": "なかなか　来ないからって\nホップが　探しに　向かいましたよ",
    "episode_event_8070_zagirl_and_gai/4002_1001_700_10": "ダンデって……　あの\nガラル地方の　スゴ腕トレーナーか！？",
    "episode_event_8070_zagirl_and_gai/4002_1001_800_10": "お名前　きいたことあります！",
    "episode_event_8070_zagirl_and_gai/4002_1001_900_10": "ははは！　それは　光栄だぜ！",
    "episode_event_8070_zagirl_and_gai/4002_1001_1000_10": "確か　ふたりは　カロス地方の\nミアレシティから　来たんだよな？",
    "episode_event_8070_zagirl_and_gai/4002_1001_1100_10": "そっちの　セレナと　カルムも\nカロス出身　なんだぜ！",
    "episode_event_8070_zagirl_and_gai/4002_1001_1200_10": "へえ……！　ミアレから",
    "episode_event_8070_zagirl_and_gai/4002_1001_1300_10": "まさか　こんなところで\n同じ地方の　人と\n会えると　思わなかった",
    "episode_event_8070_zagirl_and_gai/4002_1001_1400_10": "ミアレは　アタシたちにも\nたくさんの　思い出がある　場所なのよ",
    "episode_event_8070_zagirl_and_gai/4002_1001_1500_10": "最近は　ワイルドゾーンが　増えて\n戸惑っている人も　いるけど……\nふたりは　受け入れている？",
    "episode_event_8070_zagirl_and_gai/4002_1001_1600_10": "ええと……　ワイルドゾーン？\nそれは　なんだい？",
    "episode_event_8070_zagirl_and_gai/4002_1001_1700_10": "まさか　知らないのか……！？",
    "episode_event_8070_zagirl_and_gai/4002_1001_1800_10": "ミアレに来て　ワイルドゾーンを\nみかけない　なんてことは\nないはずだけど……？",
    "episode_event_8070_zagirl_and_gai/4002_1001_1900_10": "ちなみに　セレナと　カルムは\n優秀なトレーナーでも　あるんだぜ",
    "episode_event_8070_zagirl_and_gai/4002_1001_2000_10": "今日の　大会にも\n参加するんだよな？",
    "episode_event_8070_zagirl_and_gai/4002_1001_2100_10": "はい！　ともだち　みんなで！",
    "episode_event_8070_zagirl_and_gai/4002_1001_2200_10": "それだけ腕に　自信があるなら\nいつか　「ＺＡロワイヤル」で\n顔を　あわせるかも　しれないな",
    "episode_event_8070_zagirl_and_gai/4002_1001_2300_10": "ＺＡロワイヤル……？",
    "episode_event_8070_zagirl_and_gai/4002_1001_2400_10": "あれ？　これも　知らない？",
    "episode_event_8070_zagirl_and_gai/4002_1001_2500_10": "なんか　変だな……\n話が　かみあわない",
    "episode_event_8070_zagirl_and_gai/4002_1001_2600_10": "……もしかして",
    "episode_event_8070_zagirl_and_gai/4002_1001_2700_10": "ああ……　オレも\n同じこと　考えてた",
    "episode_event_8070_zagirl_and_gai/4002_1001_2800_10": "たぶんだけど　ふたりと\nアタシたちの　知る　ミアレは\n少し　違っているのかも……",
    "episode_event_8070_zagirl_and_gai/4002_1001_2900_10": "違う　ミアレ……？",
    "episode_event_8070_zagirl_and_gai/4002_1001_3000_10": "パシオには　異なる時空や\n時代から　やってきた人や\nポケモンが　いるんだ",
    "episode_event_8070_zagirl_and_gai/4002_1001_3100_10": "だから　オレたちが　知っている\nミアレは　それぞれ　別の\nミアレ　なんじゃないかって",
    "episode_event_8070_zagirl_and_gai/4002_1001_3200_10": "あり得る話だな",
    "episode_event_8070_zagirl_and_gai/4002_1001_3300_10": "オレの　身の回りにも\nそんな経験をした　人たちがいるよ",
    "episode_event_8070_zagirl_and_gai/4002_1001_3400_10": "突拍子もない　話では\nあるけど……",
    "episode_event_8070_zagirl_and_gai/4002_1001_3500_10": "わたしたちも　エムゼット団で\n不思議な依頼を　こなして　きたからね",
    "episode_event_8070_zagirl_and_gai/4002_1001_3600_10": "そういうことも　あるかもって\n受け入れられちゃう",
    "episode_event_8070_zagirl_and_gai/4002_1001_3700_10": "ああ　こうなったら　もう\nなんだって　来いだ！",
    "episode_event_8070_zagirl_and_gai/4002_1001_3800_10": "ところで　ダンデさん\nすっかり　話しこんじゃったけど\n時間の　ほうは……",
    "episode_event_8070_zagirl_and_gai/4002_1001_3900_10": "マズい！\nそろそろ　向かわないと　遅れる！",
    "episode_event_8070_zagirl_and_gai/4002_1001_4000_10": "急ぎましょう！",
    "episode_event_8070_zagirl_and_gai/4003_1101_100_20": "少し　遅れてしまったが\n無事に　ダンデを　会場に\n案内できた　一同",
    "episode_event_8070_zagirl_and_gai/4003_1101_200_20": "しかし　場内が　騒がしい……",
    "episode_event_8070_zagirl_and_gai/4003_1001_100_10": "あの人たちは……！？",
    "episode_event_8070_zagirl_and_gai/4003_1001_200_10": "あいつらは　ロケット団だよ",
    "episode_event_8070_zagirl_and_gai/4003_1001_300_10": "人や　ポケモンに\n悪さする　人たちなの",
    "episode_event_8070_zagirl_and_gai/4003_1001_400_10": "ためらいもなく\n盗みや　脅迫めいたことを\n繰り返しているんだ",
    "episode_event_8070_zagirl_and_gai/4003_1001_500_10": "そんな悪党が　いるなんて……！",
    "episode_event_8070_zagirl_and_gai/4003_1001_600_10": "一体　なにをしに\nここへ……",
    "episode_event_8070_zagirl_and_gai/4003_1001_700_10": "待って！\nあそこに　いるのって……",
    "episode_event_8070_zagirl_and_gai/4003_1001_800_10": "この前　ボクの研究所に　忍びこんで\nデータを　盗んだのは　キミたちだよね？",
    "episode_event_8070_zagirl_and_gai/4003_1001_900_10": "それじゃあ　今さら　ボクを\nさらう必要は　ないんじゃないかなー",
    "episode_event_8070_zagirl_and_gai/4003_1001_1000_10": "ふふん　強がっちゃって！",
    "episode_event_8070_zagirl_and_gai/4003_1001_1100_10": "そうよ　メガシンカの　研究データを\n奪ったのは　わたしたち　ロケット団！",
    "episode_event_8070_zagirl_and_gai/4003_1001_1200_10": "おかげで　「おもしろいこと」が\nできるようになってね",
    "episode_event_8070_zagirl_and_gai/4003_1001_1300_10": "あんたには　このマシーンの\n精度を　あげるために\n協力して　もらうよ",
    "episode_event_8070_zagirl_and_gai/4003_1001_1400_10": "「強制メガシンカマシーン」\nスイッチ　オン！",
    "episode_event_8070_zagirl_and_gai/4004_1001_100_10": "なんてことだ……",
    "episode_event_8070_zagirl_and_gai/4004_1001_200_10": "ポケモンを　強制的に\nメガシンカ　させるなんて……！",
    "episode_event_8070_zagirl_and_gai/4004_1001_300_10": "わっはっはっは！\n素晴らしい　力だぜ！",
    "episode_event_8070_zagirl_and_gai/4004_1001_400_10": "キーストーンも　メガストーンも\nなしに　メガシンカ　させたのか？",
    "episode_event_8070_zagirl_and_gai/4004_1001_500_10": "……おそらく　バディストーンを\n悪用したんだな",
    "episode_event_8070_zagirl_and_gai/4004_1001_600_10": "バディストーン　って……\nポリゴンフォンに　内蔵されてる\n石の　ことですよね？",
    "episode_event_8070_zagirl_and_gai/4004_1001_700_10": "ああ　バディーズの　きずなを\n力に変える　不思議な石で……",
    "episode_event_8070_zagirl_and_gai/4004_1001_800_10": "メガシンカなんかの　特別な\n現象も　起こせるんだ",
    "episode_event_8070_zagirl_and_gai/4004_1001_900_10": "そんな　とんでもないもの\nだったのかよ……",
    "episode_event_8070_zagirl_and_gai/4004_1001_1000_10": "メガシンカは　本来\nトレーナーが　身に着けている\n「キーストーン」と……",
    "episode_event_8070_zagirl_and_gai/4004_1001_1100_10": "ポケモンの　持つ\n「メガストーン」が　共鳴することで\n起こせるもの　だけど",
    "episode_event_8070_zagirl_and_gai/4004_1001_1200_10": "それに加えて　トレーナーと\nポケモンの　あいだに\n強い　きずなが　必要よ",
    "episode_event_8070_zagirl_and_gai/4004_1001_1300_10": "ああ　そうして　ポケモンが\n秘めた　パワーを\n一時的に　解放することで",
    "episode_event_8070_zagirl_and_gai/4004_1001_1400_10": "通常の　進化を　超える\nパワーアップを　するんだよな",
    "episode_event_8070_zagirl_and_gai/4004_1001_1500_10": "バディストーンに　よる\nメガシンカも　強いきずなは　不可欠",
    "episode_event_8070_zagirl_and_gai/4004_1001_1600_10": "ロケット団が　そんなきずなを\n結べるとは　思えないけど……",
    "episode_event_8070_zagirl_and_gai/4004_1001_1700_10": "だが……　きずなが　必要ない\nメガシンカなら　どうかな？",
    "episode_event_8070_zagirl_and_gai/4004_1001_1800_10": "ロケット団の　ボス　サカキ……！",
    "episode_event_8070_zagirl_and_gai/4004_1001_1900_10": "プラターヌ博士を　解放しろ！",
    "episode_event_8070_zagirl_and_gai/4004_1001_2000_10": "それは　無理な　相談だ",
    "episode_event_8070_zagirl_and_gai/4004_1001_2100_10": "わたしはね　すべての部下たちに\nメガシンカの　力の　素晴らしさを\n味わってほしいと　思っているのだよ",
    "episode_event_8070_zagirl_and_gai/4004_1001_2200_10": "だからこそ　きずなが　なくとも\nメガシンカできる\n装置を　開発したのだが……",
    "episode_event_8070_zagirl_and_gai/4004_1001_2300_10": "まだまだ　不安定でね\nプラターヌ博士の　協力が　必要なのだ",
    "episode_event_8070_zagirl_and_gai/4004_1001_2400_10": "でも　こんな　メガシンカは\nポケモンを　苦しめるだけです！",
    "episode_event_8070_zagirl_and_gai/4004_1001_2500_10": "そうだぜ！　こんなの\n暴走メガシンカと　同じじゃねえか！",
    "episode_event_8070_zagirl_and_gai/4004_1001_2600_10": "暴走メガシンカ……？",
    "episode_event_8070_zagirl_and_gai/4004_1001_2700_10": "メガエネルギーの　影響を受けた\n野生の　ポケモンが……",
    "episode_event_8070_zagirl_and_gai/4004_1001_2800_10": "望まない形で　メガシンカしてしまう\n異常現象の　ことだ",
    "episode_event_8070_zagirl_and_gai/4004_1001_2900_10": "ほう……？",
    "episode_event_8070_zagirl_and_gai/4004_1001_3000_10": "わたしたち　エムゼット団が\n中心となって　暴走メガシンカした\nポケモンを　鎮めてきたの",
    "episode_event_8070_zagirl_and_gai/4004_1001_3100_10": "だから　人の　都合で　無理やり\nメガシンカさせるなんて　許せない！",
    "episode_event_8070_zagirl_and_gai/4004_1001_3200_10": "みんな！　ロケット団を\n止めるのに　手を貸してくれ",
    "episode_event_8070_zagirl_and_gai/4004_1001_3300_10": "もちろんだ！\nこんな悪事　みすごせないぜ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_100_10": "さすがは　ガラル地方の\nチャンピオン……\nと　いいたい　ところだが",
    "episode_event_8070_zagirl_and_gai/4005_1001_200_10": "プラターヌ博士が　いることを\n忘れてもらっては　困るな",
    "episode_event_8070_zagirl_and_gai/4005_1001_300_10": "くっ……！",
    "episode_event_8070_zagirl_and_gai/4005_1001_400_10": "博士を　盾に　するなんて……！",
    "episode_event_8070_zagirl_and_gai/4005_1001_500_10": "これじゃあ　ダンデさんも\n本気で　戦えない……！",
    "episode_event_8070_zagirl_and_gai/4005_1001_600_10": "マズいな……\nこのままだと　押し負けちまう",
    "episode_event_8070_zagirl_and_gai/4005_1001_700_10": "大勢の　トレーナーと\nメガシンカポケモン……",
    "episode_event_8070_zagirl_and_gai/4005_1001_800_10": "……ねえ　ガイ！\nこれって　いつもの　わたしたちと\n状況が　似てると　思わない？",
    "episode_event_8070_zagirl_and_gai/4005_1001_900_10": "ん……？　なんのことだ？",
    "episode_event_8070_zagirl_and_gai/4005_1001_1000_10": "ＺＡロワイヤルの　こと",
    "episode_event_8070_zagirl_and_gai/4005_1001_1100_10": "ミアレシティ　でも\nたくさんの　トレーナー相手に\n勝ち抜いて　きたでしょ？",
    "episode_event_8070_zagirl_and_gai/4005_1001_1200_10": "いわれてみれば　確かにな",
    "episode_event_8070_zagirl_and_gai/4005_1001_1300_10": "だから　こんな作戦は　どうかな？",
    "episode_event_8070_zagirl_and_gai/4005_1001_1400_10": "……なるほど\nソイツは　いい手だな！",
    "episode_event_8070_zagirl_and_gai/4005_1001_1500_10": "ふたりとも\nちょっと　きいてくれ",
    "episode_event_8070_zagirl_and_gai/4005_1001_1600_10": "……わかった\nその作戦で　いこう",
    "episode_event_8070_zagirl_and_gai/4005_1001_1700_10": "必ず　成功させましょう！",
    "episode_event_8070_zagirl_and_gai/4005_1001_1800_10": "ガイ　準備はバッチリだよ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_1900_10": "それじゃあ\n作戦開始と　いこうぜ",
    "episode_event_8070_zagirl_and_gai/4005_1001_2000_10": "エムゼット団として\nいつもみたいに……",
    "episode_event_8070_zagirl_and_gai/4005_1001_2100_10": "人助け　ポケモン助けだっ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_2200_10": "いい加減にしろ！　ロケット団！",
    "episode_event_8070_zagirl_and_gai/4005_1001_2300_10": "好き放題してくれちゃって！\nこっちも　我慢の限界よ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_2400_10": "とうとう　やけに　なったか",
    "episode_event_8070_zagirl_and_gai/4005_1001_2500_10": "人質が　いることを　忘れたの？",
    "episode_event_8070_zagirl_and_gai/4005_1001_2600_10": "それ以上　暴れるなら　博士には\n痛い目に　あってもらうわ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_2700_10": "汚いまね　しやがって！\n正々堂々　勝負しろ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_2800_10": "へへへ……　ロケット団に\n歯向かうと　こうなるのさ",
    "episode_event_8070_zagirl_and_gai/4005_1001_2900_10": "いつの間に　背後へ！？",
    "episode_event_8070_zagirl_and_gai/4005_1001_3000_10": "前ばっかり　みてるからだよ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_3100_10": "大丈夫ですか？",
    "episode_event_8070_zagirl_and_gai/4005_1001_3200_10": "助かったよ！　ありがとう！",
    "episode_event_8070_zagirl_and_gai/4005_1001_3300_10": "よし！　作戦成功だ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_3400_10": "博士は　アタシたちが\n安全な　ところへ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_3500_10": "ま　待ちなさーいっ！",
    "episode_event_8070_zagirl_and_gai/4005_1001_3600_10": "おいおい\nよそみしてて　いいのか？",
    "episode_event_8070_zagirl_and_gai/4006_1001_100_10": "ほほう……！",
    "episode_event_8070_zagirl_and_gai/4006_1001_200_10": "やるな！　ふたりとも！",
    "episode_event_8070_zagirl_and_gai/4006_1001_300_10": "ならば　こちらも　本気でいこう",
    "episode_event_8070_zagirl_and_gai/4006_1001_400_10": "ミュウツー　メガシンカ！",
    "episode_event_8070_zagirl_and_gai/4006_1001_500_10": "……すまない　リザードン\nこれまで　よく持ちこたえてくれた",
    "episode_event_8070_zagirl_and_gai/4006_1001_600_10": "強制メガシンカとは　違う……！？",
    "episode_event_8070_zagirl_and_gai/4006_1001_700_10": "ロケット団にも\nきずなは　あるのだよ",
    "episode_event_8070_zagirl_and_gai/4006_1001_800_10": "純粋なる　「悪のきずな」　が！",
    "episode_event_8070_zagirl_and_gai/4006_1001_900_10": "悪のきずな……",
    "episode_event_8070_zagirl_and_gai/4006_1001_1000_10": "それって　強いの？\nわたしたちの　きずなより",
    "episode_event_8070_zagirl_and_gai/4006_1001_1100_10": "みせてやろうぜ！\nエムゼット団　リーダーと\n切り札の　実力を！",
    "episode_event_8070_zagirl_and_gai/4006_1001_1200_10": "オーダイル！　メガシンカ！",
    "episode_event_8070_zagirl_and_gai/4006_1001_1300_10": "こっちも　いくぜ\nメガシンカだ　メガニウム！",
    "episode_event_8070_zagirl_and_gai/4007_1001_100_10": "オーダイルと　メガニウムが\nメガシンカ……！？",
    "episode_event_8070_zagirl_and_gai/4007_1001_200_10": "驚いたよ……\nこれまで　みたことが　ない姿だ！",
    "episode_event_8070_zagirl_and_gai/4007_1001_300_10": "そろそろ　観念して　もらうぜ",
    "episode_event_8070_zagirl_and_gai/4007_1001_400_10": "わたしたち\nエムゼット団が　いる限り……",
    "episode_event_8070_zagirl_and_gai/4007_1001_500_10": "どんな人も　ポケモンも\n苦しめさせは　しない！",
    "episode_event_8070_zagirl_and_gai/4007_1001_600_10": "なかなか　やる……！",
    "episode_event_8070_zagirl_and_gai/4007_1001_700_10": "……メガシンカとは　奥が深いものだな",
    "episode_event_8070_zagirl_and_gai/4007_1001_800_10": "今日のところは　手をひこう\n暴走メガシンカ　という\n興味深い話が　きけたことだしな",
    "episode_event_8070_zagirl_and_gai/4007_1001_900_10": "我々の　強制メガシンカが　持つ\n可能性と　未来が　みえたよ",
    "episode_event_8070_zagirl_and_gai/4008_1001_100_10": "改めて……\n大会の　開始時間に　遅れてしまって\n申し訳ない！",
    "episode_event_8070_zagirl_and_gai/4008_1001_200_10": "ロケット団の　悪事については\nもう　知っているだろう？",
    "episode_event_8070_zagirl_and_gai/4008_1001_300_10": "しかし　それも\nここにいる　勇気あるトレーナー！",
    "episode_event_8070_zagirl_and_gai/4008_1001_400_10": "セイカや　ガイたちの　協力によって\n解決することが　できた！",
    "episode_event_8070_zagirl_and_gai/4008_1001_500_10": "その力　直接　みせてもらえるか？",
    "episode_event_8070_zagirl_and_gai/4008_1001_600_10": "もちろん　喜んで！",
    "episode_event_8070_zagirl_and_gai/4008_1001_700_10": "負けるつもりは　ないですよ？",
    "episode_event_8070_zagirl_and_gai/4008_1001_800_10": "そうでなくちゃな！",
    "episode_event_8070_zagirl_and_gai/4008_1001_900_10": "さあ！\nチャンピオン　タイムを　楽しめ！",
    "episode_event_8070_zagirl_and_gai/4009_1101_100_20": "大会終了後……",
    "episode_event_8070_zagirl_and_gai/4009_1001_100_10": "いろいろあった　一日だったな",
    "episode_event_8070_zagirl_and_gai/4009_1001_200_10": "うん　ちょっとした\n観光の　つもり　だったのに……",
    "episode_event_8070_zagirl_and_gai/4009_1001_300_10": "メガシンカを　悪用する\n組織と　戦うことに　なるなんて",
    "episode_event_8070_zagirl_and_gai/4009_1001_400_10": "ああいう　連中は\nロケット団以外にも　いるんだ",
    "episode_event_8070_zagirl_and_gai/4009_1001_500_10": "またいつ　物騒な事件が\n起きるとも　わからないのか",
    "episode_event_8070_zagirl_and_gai/4009_1001_600_10": "……ガイ\nわたし　もうしばらく\nパシオに　残りたい",
    "episode_event_8070_zagirl_and_gai/4009_1001_700_10": "また　事件が　起きたとき\nみんなの　助けに　なりたいから！",
    "episode_event_8070_zagirl_and_gai/4009_1001_800_10": "偶然だな\nオレも　同じこと　考えてたんだ",
    "episode_event_8070_zagirl_and_gai/4009_1001_900_10": "そうしてくれると\nすごく　心強いわ！",
    "episode_event_8070_zagirl_and_gai/4009_1001_1000_10": "メガシンカに　関する話も\nききたいと　思ってたしね！",
    "episode_event_8070_zagirl_and_gai/4009_1001_1100_10": "よし！　新たな　仲間が\n増えたことだし……",
    "episode_event_8070_zagirl_and_gai/4009_1001_1200_10": "お祝いに　ホテルＺの　人気メニュー\nクロワッサンカレーを　ごちそうするぜ！",
    "episode_event_8070_zagirl_and_gai/4009_1001_1300_10": "カレーか！　それは　楽しみだな！",
    "episode_event_8070_zagirl_and_gai/4009_1001_1400_10": "クロワッサンに　カレー……？",
    "episode_event_8070_zagirl_and_gai/4009_1001_1500_10": "どんな　料理か\nイメージ　つかないわ……",
    "episode_event_8070_zagirl_and_gai/4009_1001_1600_10": "ふたりがいた　ミアレシティでは\n名物なのかい？",
    "episode_event_8070_zagirl_and_gai/4009_1001_1700_10": "ふふっ\nそういうわけじゃ　ないんですけど……",
    "episode_event_8070_zagirl_and_gai/4009_1001_1800_10": "とにかく　食えば　わかる！",
    "episode_event_8070_zagirl_and_gai/4009_1001_1900_10": "そのうち　パシオでも\n人気メニューに　してやるぜ！"
}
