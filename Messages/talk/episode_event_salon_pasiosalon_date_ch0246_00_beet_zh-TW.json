{
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0100_20": "[Name:PlayerNickname ]看到了\n彼特在跟破壞隊隊員對戰。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0200_20": "為了幫彼特助陣，\n[SC:Gen Ref=\"255\" M=\"他\" F=\"她\" ]加入了對戰。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0300_10": "……我不知道\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]在打什麼算盤，",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0400_10": "但如果要助陣的話，\n麻煩別扯我的後腿。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0500_20": "[Name:PlayerNickname ]和彼特\n合力擊退了破壞隊……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0600_10": "……以表演闖入對戰來說，\n還算是過得去吧？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0700_10": "可惜比不上我就是了。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0800_10": "之前可能有跟[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]提過……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0900_10": "我偶爾會拿那些人\n來當作試身手的對象。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1000_10": "當然是只靠我一個人而已喔？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1100_10": "我有足夠的實力，\n一個人也完全應付得來。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1200_10": "所以根本不需要借助\n別人的力量。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0301_1300_10": "波普菈呢",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0401_1400_10": "什麼！？為什麼會在這時候\n提到老太婆的名字啊！？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0302_1500_10": "小優他們呢",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0402_1600_10": "……[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]是想說\n我很依賴他們嗎？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1700_10": "嗯，跟之前比起來，\n確實是有一點啦……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1800_10": "我覺得自己和他人相處的方式，\n好像變得不太一樣了……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1900_10": "這肯定是因為那個老太婆……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2000_10": "……我說太多沒必要的話了。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2100_10": "那麼我就先失陪了。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2200_10": "[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]說想要再跟我多聊一下？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2300_10": "[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]還打算繼續纏著我啊？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2400_10": "……那麼，就當作是\n還[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]剛才助陣的人情，",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2500_10": "我來稍微鍛鍊一下\n[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]吧。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1101_0100_20": "與彼特的特訓結束後……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0200_10": "哎呀哎呀，沒想到才這點程度\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]就累了……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0300_10": "想要一直贏下去的話，\n就不該讓人看見[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的弱點。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0400_10": "[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]就是太顧慮對手了。\n這點會成為[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的破綻。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0500_10": "……不對。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0600_10": "真要說起來，\n我也幫過[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]不少次。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0700_10": "[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]說助人不是壞事？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0800_10": "不，我不這麼認為。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0900_10": "要是[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]受到\n沉重無比的打擊時……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1000_10": "靠自己的力量\n沒辦法振作起來，\n那[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]會怎麼做？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1100_10": "……我以前也曾經在\n自己堅信的道路上受過挫折。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1200_10": "雖然一度因此失去了希望……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1300_10": "但即便如此，\n我還是認為自己\n成功找到了全新的光輝。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1400_10": "就算在振作起來的過程中\n有借助他人的力量，",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1500_10": "我所相信的……\n還是我自己。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1600_10": "我今後也會繼續走在\n自己選定的道路上。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1700_10": "因為我已經看見了\n絕對不會動搖的未來。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1800_10": "好了，閒聊就到此為止吧。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1900_10": "我差不多要回去了。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0301_2000_10": "我也要走同一條路回去",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0401_2100_10": "……我拒絕。\n要是跟[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]一起回去，\n豈不是會顯得我們很要好嗎？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0302_2200_10": "我們要各自回去啊……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0402_2300_10": "怎麼了，[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]幹嘛一臉遺憾的表情？",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2400_10": "我走我的路，\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]就走[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]自己的路吧。",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2500_10": "我很快就會用自己獨有的力量……",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2600_10": "把世界染成彼特的顏色，\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]就好好期待吧。"
}
