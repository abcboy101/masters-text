{
    "episode_event_ch0116_90_ch0162_90/6801_1031_100_10": "펄기아의 원래 모습...",
    "episode_event_ch0116_90_ch0162_90/6801_1001_100_10": "설마 디아루가랑 펄기아한테\n다른 모습이 있을 줄은 몰랐어",
    "episode_event_ch0116_90_ch0162_90/6801_1001_200_10": "우리도 새로운\n네오 챔피언으로서\n더 빛을 내자!",
    "episode_event_ch0116_90_ch0162_90/6801_1001_300_10": "응! 모두에게 희망의 빛을\n전달할 수 있는 버디즈가 되자!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_100_10": "이번에는 내가\n네오 챔피언배틀의\n심사 위원장을 맡도록 할게",
    "episode_event_ch0116_90_ch0162_90/4001_1001_200_10": "내가 요구하는 것은\n\"새로운 유대의 가능성\"이야!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_300_10": "아르코스를 비롯해 새로운 힘이\n계속해서 나타나고 있는 지금...",
    "episode_event_ch0116_90_ch0162_90/4001_1001_400_10": "너희들이\n\"새로운 유대의 가능성\"을\n보여 줬으면 해!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_500_10": "그렇구나...!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_600_10": "아르세우스에게 인정받은 유대에\n지지 않을 만한 가능성을 보여 달라는 말씀인가 봐!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_700_10": "응! 어려운 조건이지만...\n도전할 가치가 있을 것 같아!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_800_10": "난천! 큰일 났다!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_900_10": "마박사님!?\n무슨 일인가요!?",
    "episode_event_ch0116_90_ch0162_90/4001_1001_1000_10": "파시오의 각지에\n시공의 뒤틀림 같은 현상이\n발생하고 있어!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_1100_10": "시공의 뒤틀림이요...!?",
    "episode_event_ch0116_90_ch0162_90/4001_1001_1200_10": "어서 다른 사람들을\n안전한 장소로 피난시키거라!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_1300_10": "광휘!",
    "episode_event_ch0116_90_ch0162_90/4001_1001_1400_10": "응! 우리도 가자!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_100_10": "저건...!?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_200_10": "펄기아야!\n그 말은...",
    "episode_event_ch0116_90_ch0162_90/4002_1001_300_10": "설마 이 시공의 뒤틀림은\n태홍이 일으킨 건가...!?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_400_10": "그렇다고 하기에는\n갤럭시단의 모습이 보이질 않는데...?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_500_10": "갤럭시단이 관여한 게 아니라면\n그 사람하고 관계가 있는 건 아닐지도 몰라",
    "episode_event_ch0116_90_ch0162_90/4002_1001_600_10": "...확실히 그냥 느낌이긴 하지만\n태홍님의 펄기아는\n아닌 것 같아",
    "episode_event_ch0116_90_ch0162_90/4002_1001_700_10": "어쨌든 간에\n펄기아가 이변의 원인이라면\n진정시키는 수밖에 없어!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_800_10": "그래! 그 말이 맞아!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_900_10": "뭐, 뭐지!?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1000_10": "펄기아의 모습이...",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1100_10": "변해 버렸잖아!?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1200_10": "저 모습은...!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1300_10": "도... 도대체 무슨 일이야!?\n공간이 이상...!?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1400_10": "...어라? 아무렇지도 않네...?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1500_10": "...빛나!\n용식하고 영빈이 안 보여!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1600_10": "뭐라고!?\n설마 방금 그 현상 때문에...!?",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1700_10": "기다려! 펄기아!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1800_10": "가만히 있을 순 없어!\n어서 펄기아를 쫓아가자!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_1900_10": "응!",
    "episode_event_ch0116_90_ch0162_90/4002_1001_2000_10": "(...기분 탓일까?)",
    "episode_event_ch0116_90_ch0162_90/4002_1001_2100_10": "(저 펄기아...\n왠지 괴로워 보였어...)",
    "episode_event_ch0116_90_ch0162_90/4003_1001_100_10": "펄기아와 두 사람은\n대체 어디로 간 거지...?",
    "episode_event_ch0116_90_ch0162_90/4003_1001_200_10": "폴리곤폰으로 연락해 봐도\n전혀 반응이 없어...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_300_10": "음...\n빛나와 광휘가 본 내용대로라면 역시...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_400_10": "용식과 영빈은 펄기아의 힘에\n휘말려서 이곳이 아닌 다른 공간으로\n날려져 버렸을지도 모르겠구나",
    "episode_event_ch0116_90_ch0162_90/4003_1001_500_10": "어떻게 하죠...?\n용식하고 영빈이 걱정돼요...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_600_10": "그래... 게다가...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_700_10": "둘 말고도 펄기아의 힘에 휘말려서\n행방불명이 된 사람들이 더 있는가 봐",
    "episode_event_ch0116_90_ch0162_90/4003_1001_800_10": "정말요!? 둘이 다가 아니라고요!?",
    "episode_event_ch0116_90_ch0162_90/4003_1001_900_10": "다들 무사했으면 좋으련만...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1000_10": "...태홍의 펄기아 말고도\n다른 펄기아가 있었다니...!\n이런 게 가능한 건가요?",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1100_10": "이건 내 가설인데...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1200_10": "아르세우스의 힘과 관련이 있는 게\n아닐까 하는 생각이 들어",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1300_10": "아르세우스는 왜요...?",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1400_10": "펄기아는 디아루가와 마찬가지로\n아르세우스에 의해\n태어났다고 전해지는 포켓몬이야...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1500_10": "그리고 파시오는 지금\n아르코스의 각성자가 늘어나면서\n아르세우스의 힘이 강해져 있겠지",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1600_10": "그 힘에 이끌려서 나타났다고 해도\n특별히 이상하진 않을 거 같아",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1700_10": "그렇네요...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1800_10": "자세한 원인은\n아직 조사 중이지만 말이야",
    "episode_event_ch0116_90_ch0162_90/4003_1001_1900_10": "...하지만 그 펄기아는\n어쩐지 괴로워하는 것 같았어요",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2000_10": "흠...\n난천의 가설이 올바르다고 한다면",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2100_10": "펄기아는 지금의 파시오에 온 것으로 인해\n자신의 의사와는 상관없이 강한 힘이\n끌어내졌을지도 모르지",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2200_10": "그리고 그걸 억누르지 못하고\n폭주하고 있다는 건가요...?",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2300_10": "음...",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2400_10": "정말 그렇다고 한다면\n전 펄기아도 돕고 싶어요!",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2500_10": "그래! 일단은 우리가 펄기아를 진정시키자!",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2600_10": "사라진 사람들을 구할 방법은\n나하고 마박사님 둘이서 찾아볼게",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2700_10": "부탁하마! 빛나, 광휘!",
    "episode_event_ch0116_90_ch0162_90/4003_1001_2800_10": "네!",
    "episode_event_ch0116_90_ch0162_90/4004_1101_100_20": "빛나 일행은 윤슬의 제안에 따라\n펄기아와 관계가 깊은\n진주단의 주혜를 찾아갔지만...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_100_10": "설마 주혜님까지 행방불명이\n되어 버리셨을 줄이야...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_200_10": "그러게...\n여기저기 찾아다녀 봤지만 안 보이네...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_300_10": "내 천리안에도 모습이 보이지 않아...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_400_10": "주혜님이라면 펄기아를 진정시킬 방법을\n알고 계셨을지도 모르는데...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_500_10": "이봐, 광휘\n디아루가님의 힘을 빌려서\n펄기아님을 억누를 수는 없을까?",
    "episode_event_ch0116_90_ch0162_90/4004_1001_600_10": "모습이 변한 펄기아의 힘은\n무시무시했어요...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_700_10": "제아무리 디아루가라 한들\n그 힘에 대항할 수 있을지는...",
    "episode_event_ch0116_90_ch0162_90/4004_1001_800_10": "뭐야, 그런 거였어?",
    "episode_event_ch0116_90_ch0162_90/4004_1001_900_10": "네?",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1000_10": "너희가 봤다고 하는\n펄기아님은 원래의 힘을 해방한\n진정한 모습을 말하는 거겠지?",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1100_10": "하지만 대칭을 이루는 존재인\n디아루가님도 동일하게\n진정한 모습을 갖고 계시거든!",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1200_10": "그게... 정말인가요!?",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1300_10": "그럼!",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1400_10": "게다가 광휘 너는\n디아루가님께 인정받았잖아",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1500_10": "동료를 돕고 싶다는 마음에\n반드시 응답해 주실 거야!",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1600_10": "...네!\n노력해 볼게요!",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1700_10": "어쩐지 희망이 보이기 시작했어!",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1800_10": "응!",
    "episode_event_ch0116_90_ch0162_90/4004_1001_1900_10": "펄기아를 진정시키는 데\n우리도 힘을 보탤 수 있도록\n특훈하자!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_100_10": "다 들었어!\n빛나, 광휘!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_200_10": "특훈 상대로 날 선택하다니\n윤슬도 제법 보는 눈이 있다니까!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_300_10": "게다가 우리까지\n불러 줄 줄은 몰랐어!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_400_10": "파시오 사람들을 돕기 위해\nMZ단도 힘을 보탤게!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_500_10": "폭주한 포켓몬과의 대결이라면\n자신 있어!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_600_10": "그런데 특훈이라곤 해도\n구체적으로 뭘 하려고?",
    "episode_event_ch0116_90_ch0162_90/4005_1001_700_10": "폭주한 펄기아를 진정시키려면\n공격을 받지 않고\n계속 피할 수 있어야 해!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_800_10": "뭐...?\n그거 설마...",
    "episode_event_ch0116_90_ch0162_90/4005_1001_900_10": "맞아! 지금부터 너희들은\n복숭악동의 공격을\n피하고 또 피하고 계속 피하게 될 거야!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1000_10": "긴장감이 있어서 좋지?",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1100_10": "너무 걱정하지 마!\n우리도 함께할 거야!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1200_10": "우리가 피하는 방법을\n알려 줄 테니까 안심해!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1300_10": "듣기로는 새아하고 가이는\n영빈만큼이나 회피를 잘한다던데 정말이야?",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1400_10": "그럼! MZ단의\n회피 방식을 알려 줄게!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1500_10": "좋았어~!\n바로 특훈을 시작하자!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1600_10": "응!\n모두를 돕는 거야!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1700_10": "각오는 충분히 다졌나 보네!",
    "episode_event_ch0116_90_ch0162_90/4005_1001_1800_10": "그럼 간다!\n잘 피해!",
    "episode_event_ch0116_90_ch0162_90/4006_1101_100_20": "특훈을 마친 빛나와 광휘 일행은\n다 함께 온 파시오를 수색한 끝에\n마침내 펄기아를 찾아냈다...",
    "episode_event_ch0116_90_ch0162_90/4006_1001_100_10": "펄기아...\n엄청 괴로워 보여...!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_200_10": "정말이네...\n그러니까 꼭 진정시켜 주자!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_300_10": "디아루가!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_400_10": "모두를 돕기 위해서\n힘을 빌려줘!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_500_10": "디아루가가 빛나고 있어...!?",
    "episode_event_ch0116_90_ch0162_90/4006_1001_600_10": "이게 찬석님이 말하셨던\n디아루가의 또 다른 모습인가...!?",
    "episode_event_ch0116_90_ch0162_90/4006_1001_700_10": "대단해!\n광휘의 마음에 응답해 준 거구나!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_800_10": "...좋아, 가자! 디아루가!\n펄기아를 진정시키는 거야!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_900_10": "이게 시간과 공간을\n다스리는 힘의 충돌...!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1000_10": "싸움의 충격이\n여기까지 전해지다니!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1100_10": "하지만 펄기아를 진정시키려면\n더 가까운 곳까지 가야 해...!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1200_10": "진정하자... 나!\n광휘나 다른 사람들이\n힘써 주고 있잖아!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1300_10": "윤슬과 다른 사람들에게 배운\n회피의 극의를 잘 떠올리면서...!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1400_10": "펄기아! 부탁해!\n마음을 가라앉혀!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1500_10": "너도 사실은 이러고 싶지 않잖아!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1600_10": "큭!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1700_10": "안 돼! 펄기아!\n더 이상 모두를...\n너 자신을 상처 입히지 마...!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1800_10": "...윽!?",
    "episode_event_ch0116_90_ch0162_90/4006_1001_1900_10": "빛나! 지금이야!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2000_10": "펄기아...",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2100_10": "너도 괴로운 거지...?",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2200_10": "하지만...!\n이대로 가면 돌이킬 수 없게 돼 버려!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2300_10": "펄기아!\n나는 모두를...\n너를 돕고 싶어!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2400_10": "그러니까... 부탁이야!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2500_10": "!?",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2600_10": "펄기아...?",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2700_10": "해냈어...!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2800_10": "역시 빛나야!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_2900_10": "아니야! 이건 다 광휘랑\n디아루가가 도와준 덕분인걸!",
    "episode_event_ch0116_90_ch0162_90/4006_1001_3000_10": "이제 남은 건 사라진 사람들을\n구해 내는 것뿐이네!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_100_10": "광휘, 빛나! 사라진 사람들을\n데리고 돌아올 방법을 알아냈다!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_200_10": "펄기아의 힘에 의해\n다른 공간으로 날려진 거라면...",
    "episode_event_ch0116_90_ch0162_90/4007_1001_300_10": "동일하게 펄기아의 힘을 빌리면\n사람들을 데리고 돌아올 수 있을 거야!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_400_10": "그렇다면 바로 저희가 나설 차례네요!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_500_10": "나하고 디아루가도 도와줄게!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_600_10": "디아루가의 시간을 조종하는 힘도 합치면\n이 시간, 이 장소로 돌아올 수 있을 거야!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_700_10": "나와 빛나\n그리고 디아루가와 펄기아가\n힘을 합치면 무조건 해낼 수 있어!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_800_10": "너희 둘! 부탁한다!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_900_10": "영빈과 다른 사람들을 잘 부탁해!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_1000_10": "무슨 일 생기면\n우리 MZ단도 도우러 갈게!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_1100_10": "꼭 돌아오거라",
    "episode_event_ch0116_90_ch0162_90/4007_1001_1200_10": "네!",
    "episode_event_ch0116_90_ch0162_90/4007_1001_1300_10": "그러면 다녀오겠습니다!",
    "episode_event_ch0116_90_ch0162_90/4008_1001_100_10": "여기는... 어디지...?",
    "episode_event_ch0116_90_ch0162_90/4008_1001_200_10": "내가 지금 꿈을 꾸고 있는 건가?\n아니야...",
    "episode_event_ch0116_90_ch0162_90/4008_1001_300_10": "이 감각은...\n그때하고 같아...?",
    "episode_event_ch0116_90_ch0162_90/4008_1001_400_10": "이봐! 이 빛은 대체 뭐야!?",
    "episode_event_ch0116_90_ch0162_90/4008_1001_500_10": "저건... 펄기아님!?\n빛나랑 광휘도 있어!",
    "episode_event_ch0116_90_ch0162_90/4008_1001_600_10": "여러분! 구하러 왔어요!",
    "episode_event_ch0116_90_ch0162_90/4008_1001_700_10": "돌아가죠! 파시오로!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_100_10": "이번 소동으로 행방불명되었던 사람들은\n모두 무사히 돌아왔어!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_200_10": "펄기아는 진정되었고\n파시오의 평화도 지켜졌지...!\n이제 걱정하지 않아도 괜찮아!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_300_10": "이번 사건의 최대 공로자인\n빛나와 광휘에게\n성대한 박수를 부탁할게!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_400_10": "폭주해 버린 펄기아를\n진정시키기 위해 디아루가를\n진정한 모습으로 변화시킨 광휘!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_500_10": "그리고 그 펄기아와\n마음을 통하게 하고 버디즈가 되어\n모두를 데리고 돌아온 빛나!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_600_10": "두 사람은 신의 힘을 끌어내는\n\"새로운 유대의 가능성\"을 보여 줬어!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_700_10": "두 사람이야말로 내가 바라는\n네오 챔피언에 어울리는 사람들이야!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_800_10": "자, 원래의 모습이 된\n디아루가와 펄기아의 힘을...\n마음껏 보여 주렴!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_900_10": "나도 디아루가의 새로운 힘을\n마음껏 써 보고 싶었어!",
    "episode_event_ch0116_90_ch0162_90/4009_1001_1000_10": "그건 나도 마찬가지야!\n펄기아가 어떤 가능성을\n품고 있는지 알고 싶어!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_100_10": "멋지구나!\n이것이 시간과 공간을 다스리는 신의\n원래의 모습과 힘...!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_200_10": "멋진 승부였어!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_300_10": "광휘와 함께\n네오 챔피언이 되어서\n정말 기뻐!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_400_10": "그건 내가 할 말인걸!\n나한테 빛나는\n최고의 라이벌이야!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_500_10": "너희와 함께 있으면\n정말 가슴이 뛰는군!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_600_10": "앞으로도 계속해서\n새로운 것들을 보여 줬으면 좋겠구나!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_700_10": "네! 그럼요!\n저도 펄기아에 대해\n더 많이 알고 싶어요!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_800_10": "저도 같은 마음이에요!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_900_10": "물론 박사님의 조수로서\n연구도 도와드리면서 할 거지만요!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_1000_10": "그러면 네오 챔피언\n두 사람에게 다시 한마디 부탁할게!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_1100_10": "아무리 긴 시간이 흘러도...\n반짝이며 빛나는 풍경은 반드시 기다리고 있어요!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_1200_10": "포켓몬과 트레이너가 일으키는 기적은\n공간의 간극이 아무리 멀어도 메울 수 있어요!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_1300_10": "지금 우리와 함께 있는\n\"새로운 유대의 가능성\"을 믿고!",
    "episode_event_ch0116_90_ch0162_90/4010_1001_1400_10": "눈부시게 빛나는 네오 챔피언의 모습을\n앞으로도 전해 나갈게요!"
}
