{
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_100_10": "あっ　[Name:PlayerNickname ]\nちょうど　いいところに！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_200_10": "じつは　[Name:PlayerNickname ]に\nお願いが　あるんだけど……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_300_10": "メガシンカを　極めるために\n協力して　ほしいの！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_400_10": "……って　ごめん　ごめん\nいきなりすぎて　意味わかんないよね",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_500_10": "順番に　話すと……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_600_10": "あたしは　「継承者」として\nパシオのみんなに　メガシンカの扱い方を\n伝えてるんだけど……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_700_10": "もっと　メガシンカについて\nたくさんのことを　伝えられないかなって\n考えたんだ",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_800_10": "知ってると　思うけど\nメガシンカと　「きずな」は\n切っても　切り離せない　関係でしょ？",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_900_10": "そこで　あなたの出番って　わけ！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1000_10": "[Name:PlayerNickname ]は\nたくさんの人や　ポケモンと\nきずなを　深めているし",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1100_10": "一緒に　思い出を　作ったり\n誰かに　頼ったり　頼られたり……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1200_10": "そうやって　みんなと\nどんどん　仲良くなっていくのを\nあたしは　みてきた！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1300_10": "いろんな　きずなの形を　作ってる\n[Name:PlayerNickname ]から\nヒントを　もらえれば……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1400_10": "あたしも　今より\nメガシンカの　可能性を\n広げられるって　思うんだ！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1500_10": "だから　改めて　お願い！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_1600_10": "あなたが　知ってる　きずなの形を\nあたしに　全部　教えて！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_0301_1700_10": "お互い学びあおう　と笑う",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_0401_1800_10": "うん！　あたしからも\n教えられることが　あれば\n全部　教えちゃうよ！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_0401_1900_10": "ふたりで　もっと\nきずなに　詳しくなっちゃおう！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_0302_2000_10": "自分でよければ　と伝える",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_0402_2100_10": "本当！？　ありがとう！\nすごく　うれしいよー！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_2200_10": "よーし！　燃えてきた！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4001_1001_2300_10": "きずなの形を　たくさん\n学んじゃうぞー！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1101_100_20": "コルニと　[Name:PlayerNickname ]は\n一緒に　毎日を　過ごすうちに\nお互いから　きずなの形を　学んだ",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_200_10": "これからは　あたしも\nもっと　たくさんの人や　ポケモンと\nきずなを　深めていけそう……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_300_10": "なにより　うれしかったのは\n[Name:PlayerNickname ]との　きずなが\n深まったこと　だなー！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_400_10": "きずな　爆発ッ！！　……だね！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_500_10": "……人同士の　きずなも\n深まったら　メガシンカして\nパワーアップ　できたら　いいのにな",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_600_10": "なんてね！\n今のは　さすがに　冗談！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_700_10": "けど　メガシンカには\nそのくらい　たくさんの　可能性が\nあるって　感じてる！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_800_10": "だからね　ポケモン勝負に\n役立てるだけ　じゃなくて……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_900_10": "みんなを　幸せに　できるような\n新しい可能性を　みつけてみたい！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_0301_1000_10": "自分もみつけたい　という",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_0401_1100_10": "わかってくれる？\nあたしたち　意見が　あうねー！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_0302_1200_10": "いつか答えがみつかる　という",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_0402_1300_10": "うん！　あたしも　信じてる！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_1400_10": "メガシンカって　まだまだ\n謎が　多いけど……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_1500_10": "[Name:PlayerNickname ]と　学びあって\n改めて　気づいたことも　あるの",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_1600_10": "それは　時間をかけて\nきずなを　深めていくことが\nやっぱり　大事なんだって　こと",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_1700_10": "それと　あなたが　よき理解者で\nあるって　ことも　再確認できたかな？",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_1800_10": "えへへ……　そういうわけで\nこれからも　よろしくね！",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_1900_10": "そうだ！　[Name:PlayerNickname ]も\n思い切って　メガシンカの\n継承者を　目指してみない？",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_2000_10": "あなたなら　きっと　なれるよ！\nでも　そのときは……",
    "episode_event_salon_pasiosalon_date_ch0012_00_corni/4002_1001_2100_10": "継承者の座を　かけて\nお互い　学んだ　きずなの　力で\nメガシンカして　真剣勝負だね！"
}
