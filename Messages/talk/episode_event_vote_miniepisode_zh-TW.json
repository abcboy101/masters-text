{
    "episode_event_vote_miniepisode/4001_1001_100_10": "呀呼～！我們來採訪\n咖啡廳的籌備狀況囉～！",
    "episode_event_vote_miniepisode/4001_1001_200_10": "索妮亞！沙儷！",
    "episode_event_vote_miniepisode/4001_1001_300_10": "同學們準備得怎麼樣呀？",
    "episode_event_vote_miniepisode/4001_1001_400_10": "當然是進展順利派！",
    "episode_event_vote_miniepisode/4001_1001_500_10": "大家也都有好好聽取我的意見……\n態度非常積極喔。",
    "episode_event_vote_miniepisode/4001_1001_600_10": "雖然咖啡廳還處於籌備階段，\n但好像已經受到不少關注了呢！",
    "episode_event_vote_miniepisode/4001_1001_700_10": "什麼～！真的嗎！？\n真是太令人高興了～！",
    "episode_event_vote_miniepisode/4001_1001_800_10": "接下來要開始拿出\n十足的氣勢了！",
    "episode_event_vote_miniepisode/4001_1001_900_10": "在研發菜單上\n也得更加努力才行！",
    "episode_event_vote_miniepisode/4001_1001_1000_10": "沒錯！",
    "episode_event_vote_miniepisode/4001_1001_1100_10": "嗯嗯，大家看起來都很開心，\n真是太好了！",
    "episode_event_vote_miniepisode/4001_1001_1200_10": "你們接下來應該會繼續籌備，\n有沒有什麼令人興奮的\n獨家消息可以分享呢？",
    "episode_event_vote_miniepisode/4001_1001_1300_10": "嗯……我想想……\n硬要說的話……",
    "episode_event_vote_miniepisode/4001_1001_1400_10": "我們之前有講到\n除了石蘭的待客指導之外，\n還想推出其他能掀起話題的東西。",
    "episode_event_vote_miniepisode/4001_1001_1500_10": "我們想打造出最棒的咖啡廳，\n讓大家都能樂在其中！",
    "episode_event_vote_miniepisode/4001_1001_1600_10": "很讚喔，很讚喔～！\n能聽到這種內幕\n正是採訪的樂趣所在啊～！",
    "episode_event_vote_miniepisode/4001_1001_1700_10": "我們也很期待……\n咖啡廳會變成什麼樣子喔！"
}
