{
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1101_100_20": "某天……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_100_10": "多謝[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]陪我買東西，\n[Name:PlayerNickname ]。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_200_10": "食材都買到了，\n接下來就是做料理！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_300_10": "咦？\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]問我打算做什麼料理？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_400_10": "那當然是……\n蓋伊特製可頌咖哩啊！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_500_10": "我在帕希歐也受到了很多人的照顧，\n所以我想款待他們當作報答。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_600_10": "……還有另一點就是，",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_700_10": "我有一件想為\n帕希歐的人們做的事。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_800_10": "我希望有天可以在帕希歐\n開一間能讓拍組們住宿的旅館。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_900_10": "這個地方除了超Ｚ隊以外，\n還有很多樂於助人的訓練家不是嗎？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1000_10": "我在密阿雷的時候\n也是受到旅館Ｚ的照顧，\n各方面都得到了救贖……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1100_10": "於是我就想說要是有個地方\n能讓來到帕希歐的拍組們\n好好休息就好了。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1200_10": "所以說，我要開始在帕希歐\n經營旅館的時候，\n[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]能不能也來幫忙呢？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0301_100_10": "那是當然的！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0401_100_10": "像這樣二話不說就答應，\n真不愧是[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0302_100_10": "看報酬有多少",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_0402_100_10": "會拿到什麼樣的報酬，\n取決於[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的工作表現喔。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1300_10": "不過要實現這個目標，\n大概需要花上不少時間就是了……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4001_1001_1400_10": "總之今天謝啦！\n我會答謝[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]的，\n[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]就好好期待一下吧！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1101_100_20": "幫忙蓋伊買完東西後\n過了一陣子……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_100_10": "雖然很突然，\n但[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]明天有什麼預定嗎？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_200_10": "沒有的話就把時間空下來吧！\n我想感謝[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]那時的幫忙！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1101_200_20": "前往蓋伊指定的地點之後……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_300_10": "尊貴的客人，\n感謝您蒞臨旅館Ｚ帕希歐。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_400_10": "今天是客人您包場，\n還請您好好享受。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_500_10": "……嚇到了嗎？",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_600_10": "我之前跟[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]提到的旅館計畫！\n鎯琊同意讓我進行模擬體驗了。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_700_10": "名稱當然是叫做旅館Ｚ！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_800_10": "就像在密阿雷幫助過我的\n旅館Ｚ那樣……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_900_10": "我希望自己的旅館\n能夠成為支持許多人的力量。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1000_10": "哪天我真的在帕希歐\n成功開了旅館Ｚ的時候……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1100_10": "[Name:PlayerNickname ][SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]要當我的\n第一個客人喔。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0301_100_10": "這個想法真棒",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0401_100_10": "對吧？\n我就知道[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]會這麼說！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0302_100_10": "能當第一個客人真是榮幸",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_0402_100_10": "能聽到[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]這麼說，\n我也更有動力加油了！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1200_10": "雖然今天是暫時的模擬體驗……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1300_10": "但如果[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]願意為我加油，\n我相信一定能夠實現在帕希歐\n經營旅館Ｚ這個目標。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1400_10": "所以今後也請多指教囉！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1500_10": "好，既然都鼓起幹勁了，\n接下來就是款待的時間！",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1600_10": "我做了拿手料理\n要來感謝[SC:Gen Ref=\"255\" M=\"你\" F=\"妳\" ]之前的幫忙喔。",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1700_10": "那麼……",
    "episode_event_salon_pasiosalon_date_ch0367_00_gai/4002_1001_1800_10": "這是本旅館自豪的可頌咖哩，\n請盡情享受。"
}
