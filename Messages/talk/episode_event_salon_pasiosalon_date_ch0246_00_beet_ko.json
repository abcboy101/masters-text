{
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0100_20": "브레이크단과 싸우고 있는\n비트를 발견한 [Name:PlayerNickname ]",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0200_20": "비트를 돕기 위해\n승부에 참전했다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0300_10": "...무슨 생각인지 모르겠지만",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0400_10": "참견할 생각이라면\n발목은 잡지 말아 주시죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1101_0500_20": "비트와 협력하여\n브레이크단을 물리쳤다...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0600_10": "...난입 퍼포먼스치고는\n제법 괜찮았던 것 같네요",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0700_10": "제게는 못 미치지만요",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0800_10": "전에 얘기했을지도 모르겠지만...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_0900_10": "실력을 시험하는 연습장 삼아서\n가끔씩 녀석들을 상대하고 있습니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1000_10": "물론 혼자서 말이죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1100_10": "저는 충분히 혼자서\n해낼 수 있는 실력이 있습니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1200_10": "그러니 다른 사람의 도움은\n필요 없죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0301_1300_10": "포플러에 대해 얘기한다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0401_1400_10": "네!? 어째서 거기서\n할머니의 이름이 나오는 거죠!?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0302_1500_10": "우리와 친구들에 대해 얘기한다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_0402_1600_10": "...제가 그 사람들을\n의지한다고 말하려는 건가요?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1700_10": "뭐, 확실히\n이전보다 조금은...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1800_10": "다른 사람과 지내는 방식이\n바뀌었다고 느끼긴 하지만...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_1900_10": "그건 틀림없이 그 할머니가...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2000_10": "...쓸데없는 말을 너무 많이 했군요",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2100_10": "저는 이쯤에서 실례하겠습니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2200_10": "조금만 더 얘기를\n듣고 싶으시다고요?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2300_10": "저를 더 귀찮게 하실 생각이신가요?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2400_10": "...그렇다면 아까 도와준 걸\n갚는 셈 치고",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4001_1001_2500_10": "[Name:PlayerNickname ]님을\n조금 단련해 드리도록 하죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1101_0100_20": "비트와의 특훈이 끝났다...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0200_10": "이런 이런 이 정도로\n벌써 지치시다니...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0300_10": "계속해서 승리하고 싶으시다면\n약한 모습은 보이지 않는 게 좋을 겁니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0400_10": "당신은 상대를 너무 배려하니까요\n그런 부분은 허점이 되는 법이죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0500_10": "...아니",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0600_10": "이렇게 말하는 저도\n여러모로 당신의 힘을 빌린 적이 있었네요",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0700_10": "사람을 돕는 건 나쁘지 않다고요?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0800_10": "아니, 그것과는 다른 얘기입니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_0900_10": "만약 당신이 어찌할 방법 없이\n궁지에 몰렸을 때...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1000_10": "자신의 힘으로 일어설 수 없게 된다면\n어떻게 하실 셈이죠?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1100_10": "...저도 과거에\n자신이 믿었던 길이\n좌절되었던 적이 있었습니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1200_10": "한때는 희망을 잃었지만...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1300_10": "그럼에도 새로운 빛을\n찾아냈다고 생각합니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1400_10": "일어설 때\n다른 사람의 힘을 빌렸다고 해도",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1500_10": "그럼에도 역시...\n제가 믿는 건 자기 자신뿐입니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1600_10": "앞으로도 자신이 정한 길을\n살아가는 건 변하지 않을 겁니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1700_10": "제게는 결코 흔들리지 않는\n미래가 보이니까요",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1800_10": "그럼, 이야기는\n이쯤에서 끝내도록 하죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_1900_10": "저는 슬슬 돌아가겠습니다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0301_2000_10": "같은 길로 돌아가겠다고 말한다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0401_2100_10": "...거절하겠습니다\n같이 돌아가면 친한 사이로\n보일 테니까요",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0302_2200_10": "따로 돌아가는구나 하고 아쉬워한다",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_0402_2300_10": "뭔가요? 그 아쉬워하는 표정은?",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2400_10": "저는 제 길을\n당신은 당신의 길을 가도록 하죠",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2500_10": "머지않은 미래에 저만의 힘으로...",
    "episode_event_salon_pasiosalon_date_ch0246_00_beet/4002_1001_2600_10": "세계를 비트의 색으로\n물들여 보일 테니\n기대하고 계시길"
}
